# Kconfig fragment for the Razer Edge Wi-Fi (nicole, SG8175P / SM8350 family).
# Applied on top of arch/arm64/configs/defconfig:
#   make ARCH=arm64 defconfig razer.config      (build-kernel.sh copies this file
#                                                into arch/arm64/configs/)
#
# Rule of thumb for early bring-up: everything needed to reach a shell over USB
# (clocks, pinctrl, interconnect, RPMh, SMMU, USB gadget, SD card, framebuffer
# console) is built in (=y) so a module-less mini initramfs works. Everything for
# later milestones (GPU, Wi-Fi, battery, fan, touch) is =m.
# Symbols that do not exist in a given kernel version are ignored by Kconfig;
# build-kernel.sh prints every line of this fragment that did not "stick".

CONFIG_LOCALVERSION="-nicole"
# CONFIG_LOCALVERSION_AUTO is not set
CONFIG_IKCONFIG=y
CONFIG_IKCONFIG_PROC=y

# ---------------------------------------------------------------- SoC core
CONFIG_ARCH_QCOM=y
CONFIG_PINCTRL_MSM=y
CONFIG_PINCTRL_SM8350=y
CONFIG_PINCTRL_QCOM_SPMI_PMIC=y
CONFIG_COMMON_CLK_QCOM=y
CONFIG_SM_GCC_8350=y
# SM8350 display clock controller lives in dispcc-sm8250.c
CONFIG_SM_DISPCC_8250=y
CONFIG_SM_GPUCC_8350=m
CONFIG_SM_VIDEOCC_8350=m
CONFIG_QCOM_CLK_RPMH=y
CONFIG_INTERCONNECT=y
CONFIG_INTERCONNECT_QCOM=y
CONFIG_INTERCONNECT_QCOM_SM8350=y
CONFIG_QCOM_RPMH=y
CONFIG_QCOM_COMMAND_DB=y
CONFIG_QCOM_RPMHPD=y
CONFIG_REGULATOR_QCOM_RPMH=y
CONFIG_QCOM_PDC=y
CONFIG_QCOM_SMEM=y
CONFIG_QCOM_SCM=y
CONFIG_QCOM_AOSS_QMP=y
CONFIG_MAILBOX=y
CONFIG_QCOM_IPCC=y
CONFIG_QCOM_SOCINFO=y
CONFIG_QCOM_LLCC=y
CONFIG_ARM_SMMU=y
CONFIG_ARM_SMMU_QCOM=y
CONFIG_ARM_QCOM_CPUFREQ_HW=y
CONFIG_QCOM_GENI_SE=y
CONFIG_QCOM_GPI_DMA=y
CONFIG_SPMI=y
CONFIG_SPMI_MSM_PMIC_ARB=y
CONFIG_MFD_SPMI_PMIC=y
CONFIG_REGULATOR_QCOM_SPMI=y
CONFIG_QCOM_SPMI_TEMP_ALARM=m
CONFIG_QCOM_TSENS=y
CONFIG_QCOM_LMH=m
CONFIG_QCOM_SPMI_ADC5=m
CONFIG_QCOM_SPMI_ADC_TM5=m
CONFIG_QCOM_STATS=m
CONFIG_QCOM_WDT=y
CONFIG_QCOM_PBS=m

# ---------------------------------------------------------------- Input
CONFIG_INPUT_PM8941_PWRKEY=y
# uinput: virtual touchscreen for the home-screen gesture tests (scripts/lab/cihazda/arayuz-dene.sh)
CONFIG_INPUT_UINPUT=m
CONFIG_KEYBOARD_GPIO=y
# Project driver (drivers/touchscreen/, integrated by build-kernel.sh)
CONFIG_TOUCHSCREEN_FOCALTECH_FT3658S_SPI=m

# ---------------------------------------------------------------- Buses
CONFIG_SERIAL_QCOM_GENI=y
CONFIG_SERIAL_QCOM_GENI_CONSOLE=y
CONFIG_SERIAL_DEV_BUS=y
CONFIG_I2C_QCOM_GENI=y
CONFIG_I2C_GPIO=y
CONFIG_SPI=y
CONFIG_SPI_QCOM_GENI=y

# ---------------------------------------------------------------- Storage
# microSD (sdhc_2) carries the rootfs. Internal UFS stays disabled in DTS (docs/guvenlik-kurallari.md);
# the drivers are built in so the module-less mini initramfs can read the firmware
# partitions read-only in the Faz 3 extraction variant (scripts/lab/ufs-oku.sh).
CONFIG_MMC=y
CONFIG_MMC_BLOCK=y
CONFIG_MMC_SDHCI=y
CONFIG_MMC_SDHCI_PLTFM=y
CONFIG_MMC_SDHCI_MSM=y
CONFIG_SCSI_UFSHCD=y
CONFIG_SCSI_UFSHCD_PLATFORM=y
CONFIG_SCSI_UFS_QCOM=y
CONFIG_PHY_QCOM_QMP_UFS=y
CONFIG_EXT4_FS=y
CONFIG_VFAT_FS=y
CONFIG_F2FS_FS=m
CONFIG_BTRFS_FS=m

# ---------------------------------------------------------------- USB (gadget first)
CONFIG_USB=y
CONFIG_USB_DWC3=y
CONFIG_USB_DWC3_DUAL_ROLE=y
CONFIG_USB_DWC3_QCOM=y
# HS PHY must be built in: the mini initramfs has no modules and the DTS runs
# usb_1 HS-only (peripheral). Symbol name in mainline 7.x: PHY_QCOM_USB_SNPS_FEMTO_V2.
CONFIG_PHY_QCOM_USB_SNPS_FEMTO_V2=y
CONFIG_PHY_QCOM_QMP=y
# QMP combo (USB3/DP) is PHASE 3; it depends on TYPEC, which is =m here, so it can only be =m.
CONFIG_PHY_QCOM_QMP_COMBO=m
CONFIG_PHY_QCOM_QMP_USB=y
CONFIG_USB_ROLE_SWITCH=y
CONFIG_USB_GADGET=y
CONFIG_USB_LIBCOMPOSITE=y
CONFIG_USB_CONFIGFS=y
CONFIG_USB_CONFIGFS_SERIAL=y
CONFIG_USB_CONFIGFS_ACM=y
CONFIG_USB_CONFIGFS_NCM=y
CONFIG_USB_CONFIGFS_ECM=y
CONFIG_USB_CONFIGFS_RNDIS=y
CONFIG_USB_CONFIGFS_MASS_STORAGE=y
CONFIG_USB_CONFIGFS_F_FS=y
CONFIG_CONFIGFS_FS=y
# USB-C: pmic_glink (ADSP) + NB7VPQ904M redriver; later milestones
CONFIG_TYPEC=m
CONFIG_TYPEC_UCSI=m
CONFIG_UCSI_PMIC_GLINK=m
CONFIG_TYPEC_MUX_NB7VPQ904M=m
CONFIG_TYPEC_MUX_GPIO_SBU=m

# ---------------------------------------------------------------- Display
# Early console: bootloader splash buffer via simple-framebuffer (simpledrm) + fbcon.
CONFIG_DRM=y
CONFIG_DRM_SIMPLEDRM=y
CONFIG_DRM_FBDEV_EMULATION=y
CONFIG_FRAMEBUFFER_CONSOLE=y
CONFIG_FRAMEBUFFER_CONSOLE_ROTATION=y
# CONFIG_FRAMEBUFFER_CONSOLE_DEFERRED_TAKEOVER is not set
CONFIG_FONTS=y
CONFIG_FONT_8x16=y
CONFIG_FONT_TER16x32=y
CONFIG_VT=y
CONFIG_VT_CONSOLE=y
# Real display/GPU (M2)
CONFIG_DRM_MSM=m
CONFIG_DRM_MSM_DPU=y
CONFIG_DRM_MSM_DSI=y
CONFIG_DRM_MSM_DSI_7NM_PHY=y
CONFIG_DRM_MSM_DP=y
CONFIG_DRM_PANEL_VISIONOX_VTDR6130=m
CONFIG_BACKLIGHT_CLASS_DEVICE=y

# ---------------------------------------------------------------- Remoteproc / IPC (M3)
CONFIG_REMOTEPROC=y
CONFIG_QCOM_Q6V5_PAS=m
CONFIG_QCOM_SYSMON=m
CONFIG_QCOM_SMP2P=y
CONFIG_RPMSG=y
CONFIG_RPMSG_QCOM_GLINK_SMEM=m
CONFIG_QRTR=m
CONFIG_QRTR_SMD=m
CONFIG_QRTR_MHI=m
CONFIG_QCOM_PD_MAPPER=m
CONFIG_QCOM_PDR_HELPERS=m
CONFIG_QCOM_FASTRPC=m
# Battery / charger / USB-C altmode over pmic_glink (ADSP)
CONFIG_QCOM_PMIC_GLINK=m
CONFIG_BATTERY_QCOM_BATTMGR=m
CONFIG_POWER_SUPPLY=y

# ---------------------------------------------------------------- Fan / thermal (M3)
# MAX31760 sits on an i2c-gpio bus in the Razer DT. Built as a module on purpose:
# its probe may reprogram the controller (PWM/LUT), so the bootloader-left fan state
# is kept until we deliberately load it (docs/guvenlik-kurallari.md: never turn the fan off).
CONFIG_SENSORS_MAX31760=m
CONFIG_THERMAL=y
CONFIG_THERMAL_OF=y
CONFIG_CPU_THERMAL=y

# ---------------------------------------------------------------- PCIe + Wi-Fi (M4)
CONFIG_PCI=y
CONFIG_PCIE_QCOM=y
CONFIG_PHY_QCOM_QMP_PCIE=y
CONFIG_MHI_BUS=m
CONFIG_CFG80211=m
CONFIG_MAC80211=m
CONFIG_ATH11K=m
CONFIG_ATH11K_PCI=m
# defconfig already has POWER_SEQUENCING=y (bool-selected), keep it
CONFIG_POWER_SEQUENCING=y
CONFIG_POWER_SEQUENCING_QCOM_WCN=m
CONFIG_PCI_PWRCTRL_PWRSEQ=m
# (old name PCI_PWRCTL_PWRSEQ is now a transitional symbol; not needed)

# ---------------------------------------------------------------- Bluetooth
CONFIG_BT=m
CONFIG_BT_HCIUART=m
CONFIG_BT_HCIUART_SERDEV=y
CONFIG_BT_HCIUART_QCA=y
CONFIG_BT_QCA=m

# ---------------------------------------------------------------- Video / audio
CONFIG_VIDEO_QCOM_VENUS=m
CONFIG_VIDEO_QCOM_IRIS=m
CONFIG_SND_SOC_QCOM=m
CONFIG_SND_SOC_SM8250=m
CONFIG_SND_SOC_QDSP6=m
# speakers: 2x AW88261 on PRI MI2S (2026-10-28)
CONFIG_SND_SOC_AW88261=m

# ---------------------------------------------------------------- Firmware loading
CONFIG_FW_LOADER=y
CONFIG_FW_LOADER_COMPRESS=y
CONFIG_FW_LOADER_COMPRESS_XZ=y
CONFIG_FW_LOADER_COMPRESS_ZSTD=y

# ---------------------------------------------------------------- initramfs / debug
CONFIG_BLK_DEV_INITRD=y
CONFIG_RD_GZIP=y
CONFIG_RD_ZSTD=y
CONFIG_RD_LZ4=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_PRINTK_TIME=y
CONFIG_MAGIC_SYSRQ=y
CONFIG_DEBUG_FS=y
CONFIG_DYNAMIC_DEBUG=y
# ramoops: needs a reserved-memory "ramoops" node in the DTS (TODO(cihaz): free region)
CONFIG_PSTORE=y
CONFIG_PSTORE_RAM=y
CONFIG_PSTORE_CONSOLE=y
CONFIG_PSTORE_PMSG=y
# Suspend debugging (30 Ekim): /sys/power/pm_test stages, pm_print_times,
# pm_debug_messages; the first s2idle try reset the phone with no log.
CONFIG_PM_DEBUG=y
CONFIG_PM_SLEEP_DEBUG=y
CONFIG_PM_ADVANCED_DEBUG=y
# QEMU smoke test only (scripts/build/qemu-smoke.sh): virtual UDC so the mini
# initramfs USB gadget + NCM + udhcpd path can be tested without the device.
CONFIG_USB_DUMMY_HCD=m
# "reboot bootloader" (izle.sh safety stop, reboot-mode): PMK8350 SDAM 0x7100+0x48,
# bootloader = 0x02 (same cell as Razer's restart_reason). Built in so the stop
# path never depends on module autoloading.
CONFIG_NVMEM_SPMI_SDAM=y
CONFIG_NVMEM_REBOOT_MODE=y
# Lockup detectors: the APSS watchdog belongs to Gunyah (no wdt node), so a hung
# kernel only recovers through these + the *_panic / panic=30 cmdline. Without them
# the cmdline knobs are no-ops (2026-10-25: "kernel.hung_task_panic: parameter not found").
CONFIG_SOFTLOCKUP_DETECTOR=y
CONFIG_HARDLOCKUP_DETECTOR=y
CONFIG_DETECT_HUNG_TASK=y

# ---------------------------------------------------------------- postmarketOS requirements
# postmarketos-zram-swap.service fails without it (29 Ekim)
CONFIG_ZRAM=m
CONFIG_ZSMALLOC=y
# zramstart asks for zstd by default; with only the LZO backend zramctl fails
# with "failed to set algorithm: Invalid argument" (29 Ekim, r5)
CONFIG_ZRAM_BACKEND_LZ4=y
CONFIG_ZRAM_BACKEND_ZSTD=y
CONFIG_ZRAM_DEF_COMP_ZSTD=y
# From "pmbootstrap kconfig check linux-razer-nicole" (categories default + nftables),
# generated 2026-10-07. Needed for the pmOS image on microSD; harmless for the mini initramfs.
CONFIG_BPF_LSM=y
CONFIG_CRYPTO_XTS=y
CONFIG_DEBUG_INFO_BTF=y
CONFIG_DEBUG_INFO_BTF_MODULES=y
CONFIG_DEBUG_INFO_DWARF5=y
# DM_CRYPT=y needs device-mapper built in
CONFIG_BLK_DEV_DM=y
CONFIG_DM_CRYPT=y
CONFIG_FTRACE=y
CONFIG_INPUT_EVDEV=m
CONFIG_IP6_NF_FILTER=m
CONFIG_IP6_NF_IPTABLES_LEGACY=m
CONFIG_IP6_NF_NAT=m
CONFIG_IP6_NF_TARGET_REJECT=m
CONFIG_IP_NF_FILTER=m
CONFIG_IP_NF_IPTABLES_LEGACY=m
CONFIG_IP_NF_NAT=m
CONFIG_IP_NF_TARGET_REJECT=m
CONFIG_KPROBES=y
CONFIG_KPROBE_EVENTS=y
CONFIG_MODULE_COMPRESS=y
CONFIG_MODULE_COMPRESS_ZSTD=y
CONFIG_MODULE_DECOMPRESS=y
CONFIG_NETFILTER_XTABLES_LEGACY=y
CONFIG_NFT_CT=m
CONFIG_NFT_LIMIT=m
CONFIG_NFT_LOG=m
CONFIG_NFT_MASQ=m
CONFIG_NFT_NAT=m
CONFIG_NFT_REJECT=m
CONFIG_NF_REJECT_IPV4=m
CONFIG_NF_REJECT_IPV6=m
CONFIG_NF_TABLES=m
CONFIG_NF_TABLES_INET=y
CONFIG_NF_TABLES_IPV4=y
CONFIG_NF_TABLES_IPV6=y
CONFIG_NLS_ASCII=y
CONFIG_NULL_TTY=m
CONFIG_PSI=y
CONFIG_SECURITY_PATH=y
CONFIG_SYN_COOKIES=y
CONFIG_UDMABUF=y
CONFIG_UEVENT_HELPER=y
# CONFIG_DEBUG_INFO_REDUCED is not set

# ---------------------------------------------------------------- platform + memory layout
# 2026-10-24: like linux-sony-pdx215 (SM8350, boots mainline under the same ABL/hyp):
# only ARCH_QCOM (arm64 defconfig enables 79 platforms -> 56 MB Image) and 48-bit VA
# (defconfig has 52-bit VA/LPA2; Sony uses 48). Suspected cause of the instant reset
# right after ABL jumps to the kernel (Deneme 3, lab log 2026-10-24).
CONFIG_ARM64_VA_BITS_48=y
# CONFIG_ARM64_VA_BITS_52 is not set
# CONFIG_ARCH_ACTIONS is not set
# CONFIG_ARCH_AIROHA is not set
# CONFIG_ARCH_SUNXI is not set
# CONFIG_ARCH_ALPINE is not set
# CONFIG_ARCH_APPLE is not set
# CONFIG_ARCH_ARTPEC is not set
# CONFIG_ARCH_ASPEED is not set
# CONFIG_ARCH_AXIADO is not set
# CONFIG_ARCH_BCM is not set
# CONFIG_ARCH_BCM2835 is not set
# CONFIG_ARCH_BCM_IPROC is not set
# CONFIG_ARCH_BCMBCA is not set
# CONFIG_ARCH_BRCMSTB is not set
# CONFIG_ARCH_BERLIN is not set
# CONFIG_ARCH_BLAIZE is not set
# CONFIG_ARCH_BST is not set
# CONFIG_ARCH_CIX is not set
# CONFIG_ARCH_EXYNOS is not set
# CONFIG_ARCH_K3 is not set
# CONFIG_ARCH_LG1K is not set
# CONFIG_ARCH_HISI is not set
# CONFIG_ARCH_KEEMBAY is not set
# CONFIG_ARCH_MEDIATEK is not set
# CONFIG_ARCH_MESON is not set
# CONFIG_ARCH_MICROCHIP is not set
# CONFIG_ARCH_SPARX5 is not set
# CONFIG_ARCH_MVEBU is not set
# CONFIG_ARCH_NXP is not set
# CONFIG_ARCH_LAYERSCAPE is not set
# CONFIG_ARCH_MXC is not set
# CONFIG_ARCH_S32 is not set
# CONFIG_ARCH_MA35 is not set
# CONFIG_ARCH_NPCM is not set
# CONFIG_ARCH_REALTEK is not set
# CONFIG_ARCH_RENESAS is not set
# CONFIG_ARCH_ROCKCHIP is not set
# CONFIG_ARCH_SEATTLE is not set
# CONFIG_ARCH_INTEL_SOCFPGA is not set
# CONFIG_ARCH_SOPHGO is not set
# CONFIG_ARCH_STM32 is not set
# CONFIG_ARCH_SYNQUACER is not set
# CONFIG_ARCH_TEGRA is not set
# CONFIG_ARCH_TESLA_FSD is not set
# CONFIG_ARCH_SPRD is not set
# CONFIG_ARCH_THUNDER is not set
# CONFIG_ARCH_THUNDER2 is not set
# CONFIG_ARCH_UNIPHIER is not set
# CONFIG_ARCH_VEXPRESS is not set
# CONFIG_ARCH_VISCONTI is not set
# CONFIG_ARCH_XGENE is not set
# CONFIG_ARCH_ZYNQMP is not set
# Haptics (30 Ekim): Awinic AW8622x on i2c19, our driver (drivers/haptics)
CONFIG_INPUT_AW8622X=m
# Gamepads (31 Ekim), for the USB host role (D1) and Bluetooth: the Razer Kishi V2 Pro
# is an XInput pad (xpad); DualShock/DualSense, Switch, Xbox BT and Steam pads use hid-*.
# UHID lets BlueZ hand BLE HID pads to the kernel. joydev for SDL/older games.
CONFIG_INPUT_JOYSTICK=y
CONFIG_INPUT_JOYDEV=m
CONFIG_JOYSTICK_XPAD=m
CONFIG_JOYSTICK_XPAD_FF=y
CONFIG_JOYSTICK_XPAD_LEDS=y
CONFIG_UHID=m
CONFIG_HID_MICROSOFT=m
CONFIG_HID_SONY=m
CONFIG_SONY_FF=y
CONFIG_HID_PLAYSTATION=m
CONFIG_PLAYSTATION_FF=y
CONFIG_HID_NINTENDO=m
CONFIG_NINTENDO_FF=y
CONFIG_HID_STEAM=m
CONFIG_STEAM_FF=y

# RTC (6 Kasım): rtc-pm8xxx is a module and cannot be set from Linux. With HCTOSYS the kernel
# puts the clock back to the bare PMIC counter (1970) when it registers; swclock-offset +
# nicole-saat (device r20) own the clock. SYSTOHC would only try to write the read-only RTC.
# CONFIG_RTC_HCTOSYS is not set
# CONFIG_RTC_SYSTOHC is not set

# Front camera, stage 1 (6 Kasım): SM8350 camera clock controller (drivers/clk patch), CCI and
# the Hi-556 sensor driver (drivers/camera patch adds its DT match). CAMSS comes in stage 2.
CONFIG_SM_CAMCC_8350=m
CONFIG_I2C_QCOM_CCI=m
CONFIG_VIDEO_HI556=m

# GPU and dma-buf imports (7 Kasım): DMABUF_DEBUG (default y with DEBUG_KERNEL) hands importers a
# copy of the sg_table without struct page and with length 0. msm builds its GPU page tables from
# sg_phys()/sg->length, so imported buffers (camera, udmabuf, dma-heap) were never mapped: the GPU
# wrote into a translation fault (CCU) and libcamera's GPU ISP output stayed all zero.
# CONFIG_DMABUF_DEBUG is not set
