From: Razer Edge port draft
Subject: [PATCH] ASoC: qcom: sm8250: turn the MI2S bit clock off at shutdown

sm8250_snd_startup() enables the bit clock of the MI2S port in the DSP
(snd_soc_dai_set_sysclk with the port's IBIT clock), but the shutdown
op only does the SoundWire part, so the clock stays voted after the
first stream. On the Razer Edge (SM8350, speakers on PRIMARY_MI2S_RX)
the ADSP stopped power-collapsing after the first playback for good.

Add a shutdown op that sets the same IBIT clock back to 0 for the DAIs
startup() turns on, then runs the SoundWire shutdown. The port itself
is already stopped by then (DAI shutdown runs before the link's).

Found on the Razer Edge (1 Kasım 2026): after playback the ADSP sleeps
again (about 30 times in 30 s), with no DSP errors.
---
diff --git a/sound/soc/qcom/sm8250.c b/sound/soc/qcom/sm8250.c
index 76dc3a3f4..47d7d62c5 100644
--- a/sound/soc/qcom/sm8250.c
+++ b/sound/soc/qcom/sm8250.c
@@ -135,6 +135,47 @@ static int sm8250_snd_startup(struct snd_pcm_substream *substream)
 	return qcom_snd_sdw_startup(substream);
 }
 
+static void sm8250_snd_shutdown(struct snd_pcm_substream *substream)
+{
+	struct snd_soc_pcm_runtime *rtd = snd_soc_substream_to_rtd(substream);
+	struct snd_soc_dai *cpu_dai = snd_soc_rtd_to_cpu(rtd, 0);
+	int clk_id;
+
+	switch (cpu_dai->id) {
+	case PRIMARY_MI2S_RX:
+		clk_id = Q6AFE_LPASS_CLK_ID_PRI_MI2S_IBIT;
+		break;
+	case SECONDARY_MI2S_RX:
+		clk_id = Q6AFE_LPASS_CLK_ID_SEC_MI2S_IBIT;
+		break;
+	case TERTIARY_MI2S_RX:
+		clk_id = Q6AFE_LPASS_CLK_ID_TER_MI2S_IBIT;
+		break;
+	case QUINARY_MI2S_RX:
+		clk_id = Q6AFE_LPASS_CLK_ID_QUI_MI2S_IBIT;
+		break;
+	case LPI_MI2S_RX_0:
+		clk_id = Q6AFE_LPASS_CLK_ID_INT0_MI2S_IBIT;
+		break;
+	case LPI_MI2S_TX_3:
+		clk_id = Q6AFE_LPASS_CLK_ID_INT3_MI2S_IBIT;
+		break;
+	default:
+		clk_id = -1;
+		break;
+	}
+
+	/*
+	 * startup() turned the bit clock on in the DSP. The port is already
+	 * stopped here (DAI shutdown runs before the link's); left on, the
+	 * clock keeps the ADSP from ever power-collapsing.
+	 */
+	if (clk_id >= 0)
+		snd_soc_dai_set_sysclk(cpu_dai, clk_id, 0, substream->stream);
+
+	qcom_snd_sdw_shutdown(substream);
+}
+
 static int sm8250_snd_prepare(struct snd_pcm_substream *substream)
 {
 	struct snd_soc_pcm_runtime *rtd = snd_soc_substream_to_rtd(substream);
@@ -155,7 +196,7 @@ static int sm8250_snd_hw_free(struct snd_pcm_substream *substream)
 
 static const struct snd_soc_ops sm8250_be_ops = {
 	.startup = sm8250_snd_startup,
-	.shutdown = qcom_snd_sdw_shutdown,
+	.shutdown = sm8250_snd_shutdown,
 	.hw_free = sm8250_snd_hw_free,
 	.prepare = sm8250_snd_prepare,
 };
