+/*
+ * Razer Edge timings: all four vendor modes (60/90/120/144Hz) share the same
+ * pixel clock and only differ in the vertical front porch (3436/1484/508/20).
+ * Only the 144Hz mode is exposed for now, as the init sequence programs the
+ * panel's internal refresh rate and the panel API does not tell us which mode
+ * was picked at prepare time.
+ */
+static const struct drm_display_mode visionox_vtdr6130_nicole_mode = {
+	.clock = (1080 + 20 + 4 + 20) * (2400 + 20 + 4 + 16) * 144 / 1000,
+	.hdisplay = 1080,
+	.hsync_start = 1080 + 20,
+	.hsync_end = 1080 + 20 + 4,
+	.htotal = 1080 + 20 + 4 + 20,
+	.vdisplay = 2400,
+	.vsync_start = 2400 + 20,
+	.vsync_end = 2400 + 20 + 4,
+	.vtotal = 2400 + 20 + 4 + 16,
+	.width_mm = 71,
+	.height_mm = 158,
+};
