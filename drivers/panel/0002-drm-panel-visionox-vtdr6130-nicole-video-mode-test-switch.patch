From: Doruk Aktun <info@dorukaktun.com>
Date: Tue, 10 Nov 2026 19:00:00 +0300
Subject: [PATCH] drm/panel: visionox-vtdr6130: nicole_video test switch (local)

Local test, not for upstream as is. With panel_visionox_vtdr6130.nicole_video=1
the Razer Edge panel ("visionox,vtdr6130-razer-nicole") keeps the board's power
sequence, reset timing and 2047 brightness cap, but takes the stock entry's
video mode, init sequence (0x6f = 0x01), timings and DSC 1.2 with 40-line
slices. That is how the Razer Edge 5G runs it (Demeter Barna, 12 Oct 2026), and
video mode never uses the command mode DSC path where the encoders got stuck.
Default off: command mode as before.

Assisted-by: Claude:claude-opus-5-5
---
diff --git a/drivers/gpu/drm/panel/panel-visionox-vtdr6130.c b/drivers/gpu/drm/panel/panel-visionox-vtdr6130.c
--- a/drivers/gpu/drm/panel/panel-visionox-vtdr6130.c
+++ b/drivers/gpu/drm/panel/panel-visionox-vtdr6130.c
@@ -81,6 +81,19 @@
 	20, 0, 0,
 };
 
+/*
+ * Test switch for the Razer Edge: drive its panel in video mode with the stock
+ * VTDR6130 init sequence and timings (as done on the Razer Edge 5G) instead of
+ * the vendor command mode setup. Video mode does not use the DPU's command
+ * mode path (ping-pong + TE), where the DSC encoders were seen getting stuck.
+ */
+static bool nicole_video;
+module_param(nicole_video, bool, 0444);
+MODULE_PARM_DESC(nicole_video, "Razer Edge: video mode with the stock sequence (test)");
+
+static const struct visionox_vtdr6130_desc visionox_vtdr6130_nicole_desc;
+static const struct visionox_vtdr6130_desc visionox_vtdr6130_nicole_video_desc;
+
 static inline struct visionox_vtdr6130 *to_visionox_vtdr6130(struct drm_panel *panel)
 {
 	return container_of(panel, struct visionox_vtdr6130, panel);
@@ -492,6 +505,10 @@
 	ctx->desc = device_get_match_data(dev);
 	if (!ctx->desc)
 		return -ENODEV;
+	if (nicole_video && ctx->desc == &visionox_vtdr6130_nicole_desc) {
+		ctx->desc = &visionox_vtdr6130_nicole_video_desc;
+		dev_info(dev, "Razer Edge panel in video mode (nicole_video=1)\n");
+	}
 
 	ret = devm_regulator_bulk_get_const(&dsi->dev,
 					    ctx->desc->num_supplies,
@@ -572,6 +589,22 @@
 	.on = visionox_vtdr6130_nicole_on,
 };
 
+/* the board's power sequence, the stock video mode panel setup */
+static const struct visionox_vtdr6130_desc visionox_vtdr6130_nicole_video_desc = {
+	.mode = &visionox_vtdr6130_mode,
+	.supplies = visionox_vtdr6130_nicole_supplies,
+	.num_supplies = ARRAY_SIZE(visionox_vtdr6130_nicole_supplies),
+	.supply_on_delay_ms = visionox_vtdr6130_nicole_supply_delays,
+	.reset_assert_ms = 25,
+	.reset_post_ms = 20,
+	.mode_flags = MIPI_DSI_MODE_VIDEO | MIPI_DSI_MODE_NO_EOT_PACKET |
+		      MIPI_DSI_CLOCK_NON_CONTINUOUS,
+	.dsc_version_minor = 0x2,
+	.dsc_slice_height = 40,
+	.max_brightness = 2047,
+	.on = visionox_vtdr6130_on,
+};
+
 static const struct of_device_id visionox_vtdr6130_of_match[] = {
 	{ .compatible = "visionox,vtdr6130", .data = &visionox_vtdr6130_desc },
 	{
