# Reference: <https://postmarketos.org/devicepkg>
#
# DRAFT device package for the Razer Edge Wi-Fi (nicole, SG8175P / SM8350 family).
# Local use only (not submitted anywhere). Based on device-sony-pdx215.
# Copy this directory to "$(pmbootstrap config aports)/device/testing/" and run
#   pmbootstrap checksum device-razer-nicole
# to fill in sha512sums.
#
# Deliberately NOT depended on:
#   soc-qcom-qbootctl  - marks A/B slots in the partition table; our images are only
#                        RAM-booted and slot handling stays manual (docs/guvenlik-kurallari.md).
#   soc-qcom-modem     - the Wi-Fi SKU has no usable modem (docs/firmware-listesi.md §2.4).
maintainer="Doruk Aktun <info@dorukaktun.com>"
pkgname=device-razer-nicole
pkgdesc="Razer Edge Wi-Fi"
pkgver=1
pkgrel=32
url="https://postmarketos.org"
license="MIT"
arch="aarch64"
options="!check !archcheck"
depends="
	linux-razer-nicole
	dtc
	python3
	mkbootimg
	alsa-ucm-conf
	alsa-utils
	bluez
	postmarketos-base
	soc-qcom
	hexagonrpcd
	hexagonrpcd-systemd
	hexagonrpcd-udev
	hexagonrpcd-yazma
	libssc
	iio-sensor-proxy
	iio-sensor-proxy-systemd
	iio-sensor-proxy-udev
	swclock-offset
	e2fsprogs-extra
	device-mapper
	util-linux-misc
"
makedepends="devicepkg-dev gcc musl-dev linux-headers"
# The speaker volume script (nicole-ses-seviye) moved here from nicole-kabuk
replaces="nicole-kabuk"
# Firmware is built from a LOCAL dump (firmware-razer-nicole), never downloaded.
# Until Faz 0 has produced that dump the firmware-razer-nicole-* subpackages cannot
# be built, so they are NOT recommended yet (the M1 image boots without firmware).
# After Faz 0 add back: firmware-razer-nicole-adsp -cdsp -gpu -wifi -bluetooth
_pmb_recommends="
	firmware-qcom-adreno-a660
	linux-firmware-qca
"
# modules-initfs lists only real modules: sdhci-msm, the HS USB PHY, dwc3(-qcom),
# libcomposite and the NCM/ACM gadget functions are built in (=y in
# scripts/build/razer.config) so even the mini initramfs gets USB networking.
# nicole-fan: mainline max31760 is no cooling device, this loop drives the fan from
# Razer's thermal trips + battery state (lab log, 25 Ekim; test:
# scripts/test/nicole-fan-test.sh). Profiles sessiz/dengeli/performans change only the
# skin table, read from /var/lib/nicole-fan/profil (docs/guvenlik-kurallari.md §8, 29 Ekim).
# nicole-ses + ucm-*: ALSA UCM profile for the "Razer-Edge" card (speakers on PRI
# MI2S, internal DMIC on the VA macro) and a oneshot that applies it at boot, as
# no PipeWire session manager runs on this image (lab log, 28 Ekim). The
# speaker amps also need aw88261_acf.bin (Razer's vendor aw882xx_acf.bin) in
# /lib/firmware/qcom/sm8350/razer/nicole/: it comes from the local dump only and
# is never packaged or published (docs/guvenlik-kurallari.md).
# kernel-cmdline.conf: fw_devlink.sync_state=timeout because msm drives the GMU
# without binding a driver to it, which would otherwise hold gcc/gpucc
# sync_state() forever (unused GDSCs never off; lab log, 29 Ekim).
# video=DSI-1:panel_orientation=normal: the console must not rotate the panel's plane;
# sway does all rotation, whichever crtc the panel lands on (1 Kasım).
# GPU zap shader (a660_zap.mbn) is Razer's: local only, never packaged.
# nicole-uyku + nicole-uyku.conf: suspend is s2idle only, and the Wi-Fi endpoint must be off
# the PCIe link while suspended or qcom-pcie's noirq suspend kills the phone (30 Ekim).
# Note: systemd 262's sshd PAM session holds a "block" sleep inhibitor, so the phone does
# not suspend while someone is logged in over ssh.
# nicole-usb-rol + .rules: udev copies UCSI's USB-C data role into dwc3's role switch
# (dr_mode otg in the DTS); pmic_glink connector@0 wired to dwc3 kept the link down (D1, 30 Ekim).
# nicole-usb-gadget + .service + .rules: sets up the USB network gadget when the initramfs
# found no UDC yet (dwc3 waits for the QMP PHY module since r9), same gadget as pmOS' (31 Ekim).
# nicole-sensor.rules: start hexagonrpcd-sdsp when its node appears, it can lose the boot race.
# nicole-sensor-denetle (+ .service, r31, 10 Kasım): iio-sensor-proxy started in the same second
# as hexagonrpcd-sdsp found light and proximity but no accelerometer, so the screen never turned
# that boot; it restarts the proxy until HasAccelerometer is true (6 tries, 15 s apart).
# nicole-uyandi (r32): after a power key wake, turns the screen on if sway's binding did not
# (started by the nicole-uyku hook via systemd-run; other wakes leave the screen off).
# nicole-titresim.rules: uaccess on the aw8622x rumble device for the session user.
# nicole-bekci + .files: returns to fastboot when the initramfs never reaches the root (5 Kasım).
# kernel-cmdline.conf names it (rdinit=), so the cmdline and an initramfs built from this
# package belong together: a boot image with rdinit= and an older initramfs panics.
# nicole-imaj: boot images in the layout ABL boots, built on the phone from /boot (5 Kasım).
# With --yaz it writes them to the running slot's own boot_x/vendor_boot_x (kernel updates
# without a Mac, docs/guvenlik-kurallari.md §8 Faz 4, 8 Kasım): only when the write guard opens them and the new
# cmdline opens them again; the old images are kept, --geri writes them back. Never runs by
# itself (deviceinfo_flash_kernel_on_update stays false): the user runs it after apk upgrade.
# nicole-bekci.yeniden on the cmdline (slot A only): restart instead of fastboot, so a bad
# kernel uses up A's tries and ABL boots the rescue Linux in B.
# nicole-a-onar: on the rescue slot B, mounts A's install and writes A's kept boot images
# back (or builds new ones), so a kernel that never boots is repaired without a Mac
# (docs/guvenlik-kurallari.md §8, 8 Kasım gece: B may write boot_a/vendor_boot_a; A never writes B).
# nicole-slot (+ .service, .timer): 3 min after a healthy boot, puts the running slot's
# boot tries back to 7 (the successful bit stays off, so 7 failed boots in a row still fall
# back to the rescue slot). Writes the LUN 4 GPT, which also holds abl/tz/hyp: both copies
# checked, one byte + CRCs, backup first; the kernel's write guard must open those blocks
# (docs/guvenlik-kurallari.md §8 Faz 4; tested on the backup copy: 18 bytes change, sgdisk clean).
# r29: ABL falls back to the other slot only when that one is marked successful (abl source,
# HandleActiveSlotUnbootable), so on A it also keeps B successful (the rescue), and
# "nicole-slot gec a|b" moves between slots by setting the two boot_x bytes so that ABL
# itself switches at the next boot (scripts/test/nicole-slot-test.py: ABL model, 31 checks).
# r30 (9 Kasım, settings app): nicole-slot tazele leaves both slots' bits in
# /run/nicole-slot.durum (read only, for a settings app), and nicole-fan.tmpfiles
# lets group plugdev (the screen user) write the fan profile.
# nicole-saat (+ drop-ins, .rules, .service, .timer): the clock never goes back past the newest
# saved time when the PMIC RTC was reset, and is set again once rtc-pm8xxx registered, because
# the kernel then puts it back to the bare RTC (6 Kasım; test: scripts/test/nicole-saat-test.sh).
# nicole-firmware-cek: copies the Razer/Qualcomm firmware from the phone's own Android
# partitions (modem_b, dsp_b, super/vendor_b), all opened read-only, into the Linux root;
# the files are never in this package (7 Kasım; verified: 156/156 files identical).
# Wi-Fi: WCN6851 (= WCN6855 hw1.1, ath11k). linux-firmware has no hw1.1 files, so
# /lib/firmware/ath11k/WCN6855/hw1.1/{amss,m3,regdb,board}.bin come from the
# device's own modem partition (board.bin = bdwlan.elf, QMI board_id 0xff): local
# dump only, never packaged (lab log, 29 Ekim). Bluetooth firmware
# (qca/wcnhpbtfw10.tlv, wcnhpnv10.bin) is upstream, in linux-firmware-qca.
source="
	deviceinfo
	kernel-cmdline.conf
	modules-initfs
	nicole-fan
	nicole-fan.service
	nicole-ses.service
	ucm-HiFi.conf
	ucm-Razer-Edge.conf
	nicole-ses-seviye
	hexagonrpcd-sdsp-yazma.conf
	nicole-sensor.tmpfiles
	nicole-fan.tmpfiles
	nicole-sensor.preset
	nicole-sensor.rules
	nicole-sensor-denetle
	nicole-sensor-denetle.service
	nicole-uyku
	nicole-uyandi
	nicole-uyku.conf
	nicole-usb-rol
	nicole-usb-rol.rules
	nicole-usb-gadget
	nicole-usb-gadget.service
	nicole-usb-gadget.rules
	nicole-titresim.rules
	nicole-bekci.c
	nicole-bekci.files
	nicole-imaj
	nicole-a-onar
	nicole-firmware-cek
	nicole-saat
	nicole-saat-boot.conf
	nicole-saat-shutdown.conf
	nicole-saat.rules
	nicole-saat.service
	nicole-saat.timer
	nicole-slot
	nicole-slot.service
	nicole-slot.timer
"

build() {
	devicepkg_build $startdir $pkgname
	gcc -static -O2 -Wall -Wextra -o nicole-bekci "$srcdir"/nicole-bekci.c
}

package() {
	devicepkg_package $startdir $pkgname

	install -Dm755 "$srcdir"/nicole-fan "$pkgdir"/usr/sbin/nicole-fan
	install -Dm644 "$srcdir"/nicole-fan.service \
		"$pkgdir"/usr/lib/systemd/system/nicole-fan.service
	mkdir -p "$pkgdir"/usr/lib/systemd/system/multi-user.target.wants
	ln -s ../nicole-fan.service \
		"$pkgdir"/usr/lib/systemd/system/multi-user.target.wants/nicole-fan.service

	install -Dm644 "$srcdir"/ucm-Razer-Edge.conf \
		"$pkgdir"/usr/share/alsa/ucm2/Razer/nicole/Razer-Edge.conf
	install -Dm644 "$srcdir"/ucm-HiFi.conf \
		"$pkgdir"/usr/share/alsa/ucm2/Razer/nicole/HiFi.conf
	mkdir -p "$pkgdir"/usr/share/alsa/ucm2/conf.d/sm8250
	ln -s ../../Razer/nicole/Razer-Edge.conf \
		"$pkgdir"/usr/share/alsa/ucm2/conf.d/sm8250/Razer-Edge.conf
	install -Dm644 "$srcdir"/nicole-ses.service \
		"$pkgdir"/usr/lib/systemd/system/nicole-ses.service
	ln -s ../nicole-ses.service \
		"$pkgdir"/usr/lib/systemd/system/multi-user.target.wants/nicole-ses.service

	install -Dm755 "$srcdir"/nicole-ses-seviye "$pkgdir"/usr/bin/nicole-ses-seviye

	# Sensors (SLPI, 30 Ekim): hexagonrpcd serves /usr/share/qcom/sm8350/razer/nicole.
	# The Razer files there (dsp/sdsp from the dsp partition, sensors/config and
	# sensors/sns_reg.conf from vendor) and slpi.mbn come from the local dump only
	# (scripts/lab/sensor-dosyalari.sh), never from this package. socinfo is what the
	# DSP would read from Android's soc0 (mainline has no hw_platform): board-id
	# 0x1001f 0x02 = HDK, subtype 2 ("hhg" sensor profiles).
	local q="$pkgdir"/usr/share/qcom/sm8350/razer/nicole
	mkdir -p "$q"/socinfo "$q"/sensors
	echo HDK > "$q"/socinfo/hw_platform
	echo HHG > "$q"/socinfo/platform_subtype
	echo 2 > "$q"/socinfo/platform_subtype_id
	echo 65536 > "$q"/socinfo/platform_version
	echo 439 > "$q"/socinfo/soc_id
	echo 2.1 > "$q"/socinfo/revision
	ln -s /var/lib/hexagonrpcd/persist-sensors "$q"/sensors/persist
	install -Dm644 "$srcdir"/hexagonrpcd-sdsp-yazma.conf \
		"$pkgdir"/usr/lib/systemd/system/hexagonrpcd-sdsp.service.d/yazma.conf
	install -Dm644 "$srcdir"/nicole-sensor.tmpfiles \
		"$pkgdir"/usr/lib/tmpfiles.d/nicole-sensor.conf
	install -Dm644 "$srcdir"/nicole-fan.tmpfiles \
		"$pkgdir"/usr/lib/tmpfiles.d/nicole-fan.conf
	install -Dm644 "$srcdir"/nicole-sensor.preset \
		"$pkgdir"/usr/lib/systemd/system-preset/80-nicole-sensor.preset
	install -Dm644 "$srcdir"/nicole-sensor.rules \
		"$pkgdir"/usr/lib/udev/rules.d/90-nicole-sensor.rules
	install -Dm755 "$srcdir"/nicole-sensor-denetle "$pkgdir"/usr/sbin/nicole-sensor-denetle
	install -Dm644 "$srcdir"/nicole-sensor-denetle.service \
		"$pkgdir"/usr/lib/systemd/system/nicole-sensor-denetle.service
	ln -s ../nicole-sensor-denetle.service \
		"$pkgdir"/usr/lib/systemd/system/multi-user.target.wants/nicole-sensor-denetle.service

	install -Dm755 "$srcdir"/nicole-uyku "$pkgdir"/usr/lib/systemd/system-sleep/nicole-uyku
	install -Dm755 "$srcdir"/nicole-uyandi "$pkgdir"/usr/libexec/nicole-uyandi
	install -Dm644 "$srcdir"/nicole-uyku.conf \
		"$pkgdir"/usr/lib/systemd/sleep.conf.d/nicole-uyku.conf

	install -Dm755 "$srcdir"/nicole-usb-rol "$pkgdir"/usr/libexec/nicole-usb-rol
	install -Dm644 "$srcdir"/nicole-usb-rol.rules \
		"$pkgdir"/usr/lib/udev/rules.d/90-nicole-usb-rol.rules
	install -Dm755 "$srcdir"/nicole-usb-gadget "$pkgdir"/usr/libexec/nicole-usb-gadget
	install -Dm644 "$srcdir"/nicole-usb-gadget.service \
		"$pkgdir"/usr/lib/systemd/system/nicole-usb-gadget.service
	install -Dm644 "$srcdir"/nicole-usb-gadget.rules \
		"$pkgdir"/usr/lib/udev/rules.d/90-nicole-usb-gadget.rules
	install -Dm644 "$srcdir"/nicole-titresim.rules \
		"$pkgdir"/usr/lib/udev/rules.d/73-nicole-titresim.rules
	install -Dm755 "$srcdir"/nicole-imaj "$pkgdir"/usr/sbin/nicole-imaj
	install -Dm755 "$srcdir"/nicole-a-onar "$pkgdir"/usr/sbin/nicole-a-onar
	install -Dm755 "$srcdir"/nicole-firmware-cek "$pkgdir"/usr/sbin/nicole-firmware-cek
	install -Dm755 nicole-bekci "$pkgdir"/usr/lib/nicole/nicole-bekci
	install -Dm644 "$srcdir"/nicole-bekci.files \
		"$pkgdir"/usr/share/mkinitfs/files/50-nicole-bekci.files

	install -Dm755 "$srcdir"/nicole-saat "$pkgdir"/usr/libexec/nicole-saat
	install -Dm644 "$srcdir"/nicole-saat-boot.conf \
		"$pkgdir"/usr/lib/systemd/system/swclock-offset-boot.service.d/nicole-saat.conf
	install -Dm644 "$srcdir"/nicole-saat-shutdown.conf \
		"$pkgdir"/usr/lib/systemd/system/swclock-offset-shutdown.service.d/nicole-saat.conf
	install -Dm644 "$srcdir"/nicole-saat.rules \
		"$pkgdir"/usr/lib/udev/rules.d/90-nicole-saat.rules
	install -Dm644 "$srcdir"/nicole-saat.service \
		"$pkgdir"/usr/lib/systemd/system/nicole-saat.service
	install -Dm644 "$srcdir"/nicole-saat.timer \
		"$pkgdir"/usr/lib/systemd/system/nicole-saat.timer
	mkdir -p "$pkgdir"/usr/lib/systemd/system/timers.target.wants
	ln -s ../nicole-saat.timer \
		"$pkgdir"/usr/lib/systemd/system/timers.target.wants/nicole-saat.timer
	install -Dm755 "$srcdir"/nicole-slot "$pkgdir"/usr/sbin/nicole-slot
	install -Dm644 "$srcdir"/nicole-slot.service \
		"$pkgdir"/usr/lib/systemd/system/nicole-slot.service
	install -Dm644 "$srcdir"/nicole-slot.timer \
		"$pkgdir"/usr/lib/systemd/system/nicole-slot.timer
	ln -s ../nicole-slot.timer \
		"$pkgdir"/usr/lib/systemd/system/timers.target.wants/nicole-slot.timer
}

