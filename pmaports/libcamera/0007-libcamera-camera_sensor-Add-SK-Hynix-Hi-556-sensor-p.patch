+++ b/src/libcamera/sensor/camera_sensor_properties.cpp
@@ -132,6 +132,29 @@ const CameraSensorProperties *CameraSensorProperties::get(const std::string &sen
 				.hblankDelay = 2
 			},
 		} },
+		{ "hi556", {
