+/*
+ * No APSS watchdog node: under the Gunyah hypervisor the APSS WDT at
+ * 0x17c10000 belongs to the hypervisor and an EL1 access aborts. With the
+ * node, qcom_wdt_probe() crashed PID 1 at 0.37 s ("Attempted to kill init",
+ * photographed 2026-10-25, lab log). Android uses the hypervisor's
+ * virtual watchdog instead (/hypervisor/qcom,hh-watchdog in the live DT,
+ * added by Gunyah's DTBO) -> Gunyah watchdog driver, later.
+ */
+
+/*
+ * Front camera, stage 1 (6 Kasım): camera clock controller, CCI1 and the Hi-556 sensor.
+ * Razer: lahaina.dtsi:2396-2407 (camcc), camera/lahaina-camera.dtsi (cci1: 0xac50000,
+ * SPI 271, cci3 pins 113/114 pulled up), camera/lahaina-camera-sensor-nicole.dtsi
+ * (sensor on cci1 master 1, MCLK5 = GPIO105 at 19.2 MHz, reset GPIO115, vio L3 1.8 V,
+ * vana L5 2.8 V, vdig L1 1.2 V, CSIPHY5, roll 270). Address 0x20 (8-bit 0x40) and chip ID
+ * 0x556 from Android's log (yedek/bugreport: "slave_addr:0x40,sensor_id:0x556").
+ * The CSI-2 endpoint has no remote yet: CAMSS for SM8350 is stage 2.
+ */
+&soc {
+	camcc: clock-controller@ad00000 {
+		compatible = "qcom,sm8350-camcc";
+		reg = <0 0x0ad00000 0 0x10000>;
+		clocks = <&rpmhcc RPMH_CXO_CLK>,
+			 <&rpmhcc RPMH_CXO_CLK_A>,
+			 <&sleep_clk>;
+		/* Zapolskiy's camcc v2 binding: CAM_CC_PLL0 at 1200 MHz needs MX at SVS_L1 */
+		power-domains = <&rpmhpd RPMHPD_MMCX>,
+				<&rpmhpd RPMHPD_MX>;
+		required-opps = <&rpmhpd_opp_low_svs>,
+				<&rpmhpd_opp_svs_l1>;
+		#clock-cells = <1>;
+		#reset-cells = <1>;
+		#power-domain-cells = <1>;
+	};
+
+	cci1: cci@ac50000 {
+		compatible = "qcom,sm8350-cci", "qcom,msm8996-cci";
+		#address-cells = <1>;
+		#size-cells = <0>;
+
+		reg = <0 0x0ac50000 0 0x1000>;
+		interrupts = <GIC_SPI 271 IRQ_TYPE_EDGE_RISING>;
+		power-domains = <&camcc TITAN_TOP_GDSC>;
+
+		clocks = <&camcc CAM_CC_CAMNOC_AXI_CLK>,
+			 <&camcc CAM_CC_SLOW_AHB_CLK_SRC>,
+			 <&camcc CAM_CC_CPAS_AHB_CLK>,
+			 <&camcc CAM_CC_CCI_1_CLK>,
+			 <&camcc CAM_CC_CCI_1_CLK_SRC>;
+		clock-names = "camnoc_axi",
+			      "slow_ahb_src",
+			      "cpas_ahb",
+			      "cci",
+			      "cci_src";
+		assigned-clocks = <&camcc CAM_CC_CCI_1_CLK_SRC>;
+		assigned-clock-rates = <37500000>;
+
+		pinctrl-0 = <&cci1_i2c1_default>;
+		pinctrl-1 = <&cci1_i2c1_sleep>;
+		pinctrl-names = "default", "sleep";
+
+		cci1_i2c1: i2c-bus@1 {
+			reg = <1>;
+			clock-frequency = <400000>;
+			#address-cells = <1>;
+			#size-cells = <0>;
+
+			camera@20 {
+				compatible = "hynix,hi556";
+				reg = <0x20>;
+
+				clocks = <&camcc CAM_CC_MCLK5_CLK>;
+				assigned-clocks = <&camcc CAM_CC_MCLK5_CLK>;
+				assigned-clock-rates = <19200000>;
+
+				dovdd-supply = <&pm8008j_l3>;
+				avdd-supply = <&pm8008j_l5>;
+				dvdd-supply = <&pm8008j_l1>;
+				reset-gpios = <&tlmm 115 GPIO_ACTIVE_LOW>;
+
+				pinctrl-0 = <&cam_mclk5_default &cam_rst5_default>;
+				pinctrl-names = "default";
+
+				orientation = <0>;	/* front */
+				rotation = <270>;
+
+				port {
+					hi556_ep: endpoint {
+						data-lanes = <1 2>;
+						link-frequencies = /bits/ 64 <437000000>;
+					};
+				};
+			};
+		};
+	};
+};
