+/*
+ * This disk also holds another operating system and the phone's boot chain and
+ * calibration data. Only commands that cannot change its contents reach the
+ * device, plus writes inside the ranges given on the command line:
+ * ufshcd_core.write_ranges=LUN:START:COUNT[,...] in logical blocks. A malformed
+ * list leaves the disk closed.
+ */
+struct ufshcd_write_range {
+	u8 lun;
+	u64 start;
+	u64 count;
+};
+static struct ufshcd_write_range ufshcd_write_ranges[8];
+static unsigned int ufshcd_nr_write_ranges;
+static char ufshcd_write_ranges_str[200];
+
+static int ufshcd_write_ranges_set(const char *val, const struct kernel_param *kp)
+{
+	const char *p = val;
+	unsigned int n = 0;
+
+	ufshcd_nr_write_ranges = 0;
+	while (*p && *p != '\n') {
+		unsigned long long start, count;
+		unsigned int lun;
+		int used = 0;
+
+		if (n == ARRAY_SIZE(ufshcd_write_ranges) ||
+		    sscanf(p, "%u:%llu:%llu%n", &lun, &start, &count, &used) != 3 ||
+		    lun > 7 || !count || start + count < start)
+			return -EINVAL;
+		ufshcd_write_ranges[n++] = (struct ufshcd_write_range) {
+			.lun = lun, .start = start, .count = count,
+		};
+		p += used;
+		if (*p == ',')
+			p++;
+		else if (*p && *p != '\n')
+			return -EINVAL;
+	}
+	strscpy(ufshcd_write_ranges_str, val);
+	ufshcd_nr_write_ranges = n;
+	return 0;
+}
+
+static int ufshcd_write_ranges_get(char *buffer, const struct kernel_param *kp)
+{
+	return sysfs_emit(buffer, "%s\n", ufshcd_write_ranges_str);
+}
+
+static const struct kernel_param_ops ufshcd_write_ranges_ops = {
+	.set = ufshcd_write_ranges_set,
+	.get = ufshcd_write_ranges_get,
+};
+module_param_cb(write_ranges, &ufshcd_write_ranges_ops, NULL, 0444);
+MODULE_PARM_DESC(write_ranges, "LUN:START:COUNT[,...]: where writes may reach the disk. Default: nowhere");
+
 static unsigned int uic_cmd_timeout = UIC_CMD_TIMEOUT_DEFAULT;
 
 static int uic_cmd_timeout_set(const char *val, const struct kernel_param *kp)
@@ -3082,6 +3139,66 @@ static int ufshcd_init_cmd_priv(struct Scsi_Host *host, struct scsi_cmnd *cmd)
 	return 0;
 }
 
+static bool ufshcd_range_is_writable(u8 lun, u64 lba, u64 count)
+{
+	unsigned int i;
+
+	if (!count || lba + count < lba)
+		return false;
+	for (i = 0; i < ufshcd_nr_write_ranges; i++) {
+		const struct ufshcd_write_range *r = &ufshcd_write_ranges[i];
+
+		if (r->lun == lun && lba >= r->start &&
+		    lba + count <= r->start + r->count)
+			return true;
+	}
+	return false;
+}
+
+static bool ufshcd_cmd_may_reach_disk(struct scsi_cmnd *cmd)
+{
