+/ {
+	/*
+	 * WCD938x (lahaina-audio-overlay.dtsi:230-282): reset GPIO88, rxtx/io/buck
+	 * from S10B 1.8 V, mic bias from BOB, all four mic biases 1.8 V. Register
+	 * access goes over the TX SoundWire bus (wcd_tx), playback over RX (wcd_rx).
+	 * nicole has no 3.5 mm jack (USB-C analog audio via FSA4480); the MBHC
+	 * thresholds are the SM8450 HDK ones until that path is brought up.
+	 */
+	wcd938x: audio-codec {
+		compatible = "qcom,wcd9380-codec";
+		pinctrl-0 = <&wcd_reset_n>;
+		pinctrl-names = "default";
+		reset-gpios = <&tlmm 88 GPIO_ACTIVE_LOW>;
+
+		vdd-buck-supply = <&pm8350_s10>;
+		vdd-rxtx-supply = <&pm8350_s10>;
+		vdd-io-supply = <&pm8350_s10>;
+		vdd-mic-bias-supply = <&vreg_bob>;
+
+		qcom,micbias1-microvolt = <1800000>;
+		qcom,micbias2-microvolt = <1800000>;
+		qcom,micbias3-microvolt = <1800000>;
+		qcom,micbias4-microvolt = <1800000>;
+		qcom,mbhc-buttons-vthreshold-microvolt = <75000 150000 237000 500000 500000 500000 500000 500000>;
+		qcom,mbhc-headset-vthreshold-microvolt = <1700000>;
+		qcom,mbhc-headphone-vthreshold-microvolt = <50000>;
+		qcom,rx-device = <&wcd_rx>;
+		qcom,tx-device = <&wcd_tx>;
+
+		#sound-dai-cells = <1>;
+	};
+
+	sound {
+		compatible = "qcom,sm8250-sndcard";
+		model = "Razer-Edge";
+		pinctrl-0 = <&pri_mi2s_active>;
+		pinctrl-names = "default";
+		/*
+		 * nicole.dtsi:79-110: the digital mics are powered from WCD938x
+		 * MIC BIAS1 / MIC BIAS3 (which DMIC sits on which bias is not
+		 * certain, so both mics pull both), the analog mic from MIC BIAS2.
+		 */
+		audio-routing = "VA DMIC0", "MIC BIAS1",
+				"VA DMIC0", "MIC BIAS3",
+				"VA DMIC1", "MIC BIAS1",
+				"VA DMIC1", "MIC BIAS3",
+				"AMIC2", "MIC BIAS2",
+				/* USB-C analog headset (FSA4480): RX macro -> WCD938x HPH */
+				"IN1_HPHL", "HPHL_OUT",
+				"IN2_HPHR", "HPHR_OUT";
+
+		mm1-dai-link {
+			link-name = "MultiMedia1";
+
+			cpu {
+				sound-dai = <&q6asmdai MSM_FRONTEND_DAI_MULTIMEDIA1>;
+			};
+		};
+
+		mm2-dai-link {
+			link-name = "MultiMedia2";
+
+			cpu {
+				sound-dai = <&q6asmdai MSM_FRONTEND_DAI_MULTIMEDIA2>;
+			};
+		};
+
+		/* DisplayPort audio front end (hw:0,2), kept after MM1/MM2 so they keep 0 and 1 */
+		mm3-dai-link {
+			link-name = "MultiMedia3";
+
+			cpu {
+				sound-dai = <&q6asmdai MSM_FRONTEND_DAI_MULTIMEDIA3>;
+			};
+		};
+
+		va-dai-link {
+			link-name = "VA Capture";
+
+			cpu {
+				sound-dai = <&q6afedai VA_CODEC_DMA_TX_0>;
+			};
+
+			platform {
+				sound-dai = <&q6routing>;
+			};
+
+			codec {
+				sound-dai = <&vamacro 0>;
+			};
+		};
+
+		wcd-capture-dai-link {
+			link-name = "WCD Capture";
+
+			cpu {
+				sound-dai = <&q6afedai TX_CODEC_DMA_TX_3>;
+			};
+
+			platform {
+				sound-dai = <&q6routing>;
+			};
+
+			codec {
+				sound-dai = <&wcd938x 1>, <&swr2 0>, <&txmacro 0>;
+			};
+		};
+
+		speaker-dai-link {
+			link-name = "Speaker Playback";
+
+			cpu {
+				sound-dai = <&q6afedai PRIMARY_MI2S_RX>;
+			};
+
+			platform {
+				sound-dai = <&q6routing>;
+			};
+
+			codec {
+				sound-dai = <&speaker_left>, <&speaker_right>;
+			};
+		};
+
+		/*
+		 * Audio to a USB-C (DP alt mode) monitor, 1 Kasım 2026: AFE
+		 * HDMI_OVER_DP_RX as on sc7180-acer-aspire1 / qcm6490-fairphone-fp5;
+		 * Razer's lahaina card has the same port (lahaina-audio.dtsi:114, dai_dp).
+		 */
+		dp-dai-link {
+			link-name = "DisplayPort Playback";
+
+			cpu {
+				sound-dai = <&q6afedai DISPLAY_PORT_RX>;
+			};
+
+			platform {
+				sound-dai = <&q6routing>;
+			};
+
+			codec {
+				sound-dai = <&mdss_dp>;
+			};
+		};
+
+		/*
+		 * USB-C analog headset (7 Nov 2026, not yet tried with an adapter):
+		 * UCSI reports an audio accessory -> typec_set_mode(AUDIO) -> FSA4480
+		 * puts D+/D- on HPH L/R and SBU on mic/ground, WCD938x MBHC reports
+		 * the jack. Same link as sm8450-hdk/sm8550-qrd, on q6afe. Last in the
+		 * node so the PCM numbers of the links above do not move.
+		 */
+		wcd-playback-dai-link {
+			link-name = "WCD Playback";
+
+			cpu {
+				sound-dai = <&q6afedai RX_CODEC_DMA_RX_0>;
+			};
+
+			platform {
+				sound-dai = <&q6routing>;
+			};
+
+			codec {
+				sound-dai = <&wcd938x 0>, <&swr1 0>, <&rxmacro 0>;
+			};
+		};
+	};
+};
+
+/*
+ * Microphones, stage 1: the two digital mics (DMIC0/1, LPASS LPI GPIO6 clock /
+ * GPIO7 data; lahaina-lpi.dtsi:1518-1570, nicole's Android "speaker-mic" =
+ * DMIC1) through the LPASS VA macro to VA_CODEC_DMA_TX_0. On bolero 2.x the
+ * DMIC clock generator lives in the VA macro, so the VA path is the one
+ * mainline can drive. SM8350's LPASS digital codec is the same generation as
+ * SC7280's (no VA SoundWire master, no NPL clock, codec v2.0/2.1), hence the
+ * sc7280 compatible until an sm8350 one exists. Addresses/clocks: Razer
+ * lahaina-audio-overlay.dtsi:27-38 and the q6afe ("Elite") clock votes.
+ * Mic power: the downstream routing feeds DMIC1/2 from WCD938x MIC BIAS1/3;
+ * stage 1 (VA only) recorded all zeros with the DMIC clock running (28 Oct),
+ * so the bias is real: stage 2 below adds WCD938x + SoundWire.
+ */
+&soc {
+	/*
+	 * Stage 2: RX/TX macros and their SoundWire masters for WCD938x (mic
+	 * bias + AMIC). Addresses/IRQs: Razer lahaina-audio-overlay.dtsi:41-75,
+	 * 120-160. TX macro: SM8350 is LPASS 9.2 (new TX SMIC mux registers),
+	 * which the sm8450 match data covers. SoundWire v1.6.0 as on the
+	 * sibling SC7280; port tables from kodiak.dtsi. No CGCR reset provider
+	 * on SM8350 yet (downstream toggles HCTL 0x032a90a0/a8), it is optional.
+	 */
+	/*
+	 * Reset-only LPASS audio CC: the SoundWire CGCR (HW clock-gating) bits.
+	 * Downstream swr-mstr clears bit 1 of HCTL 0x032a90a0 (RX) / 0x032a90a8
+	 * (TX) before using the bus; SC7280/QCM6490 has the same block at the
+	 * same address and offsets (0xa0/0xa8/0xb0). Without it every SoundWire
+	 * read after enumeration underflowed (28 Oct). Only reg index 1 is used.
+	 */
+	lpass_audiocc: clock-controller@3300000 {
+		compatible = "qcom,qcm6490-lpassaudiocc";
+		reg = <0 0x03300000 0 0x30000>,
+		      <0 0x032a9000 0 0x1000>;
+		#clock-cells = <1>;
+		#reset-cells = <1>;
+	};
+
+	rxmacro: codec@3200000 {
+		compatible = "qcom,sm8250-lpass-rx-macro";
+		reg = <0 0x03200000 0 0x1000>;
+		clocks = <&q6afecc LPASS_CLK_ID_TX_CORE_MCLK LPASS_CLK_ATTRIBUTE_COUPLE_NO>,
+			 <&q6afecc LPASS_CLK_ID_TX_CORE_NPL_MCLK LPASS_CLK_ATTRIBUTE_COUPLE_NO>,
+			 <&q6afecc LPASS_HW_MACRO_VOTE LPASS_CLK_ATTRIBUTE_COUPLE_NO>,
+			 <&q6afecc LPASS_HW_DCODEC_VOTE LPASS_CLK_ATTRIBUTE_COUPLE_NO>,
+			 <&vamacro>;
+		clock-names = "mclk", "npl", "macro", "dcodec", "fsgen";
+		#clock-cells = <0>;
+		clock-output-names = "rx-mclk";
+		#sound-dai-cells = <1>;
+		pinctrl-0 = <&rx_swr_active>;
+		pinctrl-names = "default";
+	};
+
+	swr1: soundwire@3210000 {
+		compatible = "qcom,soundwire-v1.6.0";
+		reg = <0 0x03210000 0 0x2000>;
+		interrupts = <GIC_SPI 155 IRQ_TYPE_LEVEL_HIGH>;
+		clocks = <&rxmacro>;
+		clock-names = "iface";
+		label = "RX";
+		resets = <&lpass_audiocc LPASS_AUDIO_SWR_RX_CGCR>;
+		reset-names = "swr_audio_cgcr";
+
+		qcom,din-ports = <0>;
+		qcom,dout-ports = <5>;
+		qcom,ports-word-length =	/bits/ 8 <0x01 0x07 0x04 0xff 0xff>;
+		qcom,ports-sinterval-low =	/bits/ 8 <0x03 0x3f 0x1f 0x03 0x03>;
+		qcom,ports-offset1 =		/bits/ 8 <0x00 0x00 0x0b 0x01 0x01>;
+		qcom,ports-offset2 =		/bits/ 8 <0x00 0x00 0x0b 0x00 0x00>;
+		qcom,ports-lane-control =	/bits/ 8 <0x01 0x00 0x00 0x00 0x00>;
+		qcom,ports-block-pack-mode =	/bits/ 8 <0xff 0x00 0x01 0xff 0xff>;
+		qcom,ports-hstart =		/bits/ 8 <0xff 0x03 0xff 0xff 0xff>;
+		qcom,ports-hstop =		/bits/ 8 <0xff 0x06 0xff 0xff 0xff>;
+		qcom,ports-block-group-count =	/bits/ 8 <0xff 0xff 0xff 0xff 0x00>;
+
+		#sound-dai-cells = <1>;
+		#address-cells = <2>;
+		#size-cells = <0>;
+
+		/* downstream wcd938x-rx-slave reg <0x0D 0x01170224> */
+		wcd_rx: codec@0,4 {
+			compatible = "sdw20217010d00";
+			reg = <0 4>;
+			qcom,rx-port-mapping = <1 2 3 4 5>;
+		};
+	};
+
+	txmacro: codec@3220000 {
+		compatible = "qcom,sm8450-lpass-tx-macro";
+		reg = <0 0x03220000 0 0x1000>;
+		clocks = <&q6afecc LPASS_CLK_ID_TX_CORE_MCLK LPASS_CLK_ATTRIBUTE_COUPLE_NO>,
+			 <&q6afecc LPASS_CLK_ID_TX_CORE_NPL_MCLK LPASS_CLK_ATTRIBUTE_COUPLE_NO>,
+			 <&q6afecc LPASS_HW_MACRO_VOTE LPASS_CLK_ATTRIBUTE_COUPLE_NO>,
+			 <&q6afecc LPASS_HW_DCODEC_VOTE LPASS_CLK_ATTRIBUTE_COUPLE_NO>,
+			 <&vamacro>;
+		clock-names = "mclk", "npl", "macro", "dcodec", "fsgen";
+		#clock-cells = <0>;
+		clock-output-names = "tx-mclk";
+		#sound-dai-cells = <1>;
+		pinctrl-0 = <&tx_swr_active>;
+		pinctrl-names = "default";
+	};
+
+	swr2: soundwire@3230000 {
+		compatible = "qcom,soundwire-v1.6.0";
+		reg = <0 0x03230000 0 0x2000>;
+		interrupts = <GIC_SPI 166 IRQ_TYPE_LEVEL_HIGH>;
+		clocks = <&txmacro>;
+		clock-names = "iface";
+		label = "TX";
+		resets = <&lpass_audiocc LPASS_AUDIO_SWR_TX_CGCR>;
+		reset-names = "swr_audio_cgcr";
+
+		qcom,din-ports = <3>;
+		qcom,dout-ports = <0>;
+		qcom,ports-sinterval-low =	/bits/ 8 <0x01 0x03 0x03>;
+		qcom,ports-offset1 =		/bits/ 8 <0x01 0x00 0x02>;
+		qcom,ports-offset2 =		/bits/ 8 <0x00 0x00 0x00>;
+		qcom,ports-hstart =		/bits/ 8 <0xff 0xff 0xff>;
+		qcom,ports-hstop =		/bits/ 8 <0xff 0xff 0xff>;
+		qcom,ports-word-length =	/bits/ 8 <0xff 0x00 0xff>;
+		qcom,ports-block-pack-mode =	/bits/ 8 <0xff 0xff 0xff>;
+		qcom,ports-block-group-count =	/bits/ 8 <0xff 0xff 0xff>;
+		qcom,ports-lane-control =	/bits/ 8 <0x00 0x01 0x00>;
+
+		#sound-dai-cells = <1>;
+		#address-cells = <2>;
+		#size-cells = <0>;
+
+		/* downstream wcd938x-tx-slave reg <0x0D 0x01170223>, tx_swr_ch_map */
+		wcd_tx: codec@0,3 {
+			compatible = "sdw20217010d00";
+			reg = <0 3>;
+			qcom,tx-port-mapping = <1 1 2 3>;
+		};
+	};
+
+	vamacro: codec@3370000 {
+		compatible = "qcom,sc7280-lpass-va-macro";
+		reg = <0 0x03370000 0 0x1000>;
+		clocks = <&q6afecc LPASS_CLK_ID_TX_CORE_MCLK LPASS_CLK_ATTRIBUTE_COUPLE_NO>,
+			 <&q6afecc LPASS_HW_MACRO_VOTE LPASS_CLK_ATTRIBUTE_COUPLE_NO>,
+			 <&q6afecc LPASS_HW_DCODEC_VOTE LPASS_CLK_ATTRIBUTE_COUPLE_NO>;
+		clock-names = "mclk", "macro", "dcodec";
+		#clock-cells = <0>;
+		clock-output-names = "fsgen";
+		#sound-dai-cells = <1>;
+		pinctrl-0 = <&dmic01_active>;
+		pinctrl-names = "default";
+		/* Android's TX-path DMIC rate (lahaina-audio-overlay.dtsi:48) */
+		qcom,dmic-sample-rate = <2400000>;
+	};
+};
+
+&lpass_tlmm {
+	/* lahaina-lpi.dtsi:1336-1500 */
+	tx_swr_active: tx-swr-active-state {
+		clk-pins {
+			pins = "gpio0";
+			function = "swr_tx_clk";
+			drive-strength = <4>;
+			slew-rate = <1>;
+			bias-disable;
+		};
+
+		data-pins {
+			pins = "gpio1", "gpio2", "gpio14";
+			function = "swr_tx_data";
+			drive-strength = <4>;
+			slew-rate = <1>;
+			bias-bus-hold;
+		};
+	};
+
+	rx_swr_active: rx-swr-active-state {
+		clk-pins {
+			pins = "gpio3";
+			function = "swr_rx_clk";
+			drive-strength = <2>;
+			slew-rate = <1>;
+			bias-disable;
+		};
+
+		data-pins {
+			pins = "gpio4", "gpio5";
+			function = "swr_rx_data";
+			drive-strength = <2>;
+			slew-rate = <1>;
+			bias-bus-hold;
+		};
+	};
+
+	dmic01_active: dmic01-active-state {
+		clk-pins {
+			pins = "gpio6";
+			function = "dmic1_clk";
+			drive-strength = <8>;
+			output-high;
+		};
+
+		data-pins {
+			pins = "gpio7";
+			function = "dmic1_data";
+			drive-strength = <8>;
+		};
+	};
+};
+
+/*
+ * Haptics, QUP SE19 I2C (GPIO76/77, pinctrl:1580-1592).
+ * nicole.dtsi:225-262: Awinic AW8622x ("awinic,haptic_nv") @0x5a, the
+ * AW862xx answering at 0x58, IRQ GPIO44, reset GPIO106, GPIO16/17 kept
+ * hi-Z. Mainline aw86927 does not cover AW8622x (register map differs at
+ * 0x2d/0x2e and 0x48): our drivers/haptics/aw8622x.c (continuous mode),
+ * proven from user space (i2c-dev) first, 30 Ekim.
+ */
+&i2c19 {
+	clock-frequency = <400000>;
+	status = "okay";
+
+	/*
+	 * No reset-gpios on purpose: the chip comes up with Razer's continuous
+	 * mode tuning in place and the first tests (30 Ekim) ran in that state;
+	 * a reset pulse would put the CONTCFG registers back to chip defaults.
+	 * The IRQ (GPIO44) is not used in continuous mode.
+	 */
+	haptics@58 {
+		compatible = "awinic,aw8622x";
+		reg = <0x58>;
+	};
+};
+
+/*
+ * PHASE 3: display. Downstream: DSI0 only (nicole.dtsi:569-575), panel
+ * Visionox VTDR6130 1080x2400 DSC, command mode, 4 lanes,
+ * reset GPIO24 (lahaina-sde-display-qrd.dtsi:206), TE GPIO82
+ * (lahaina-sde-display-qrd.dtsi:207, mdp_vsync pinctrl:3056-3067).
+ * Mainline panel-visionox-vtdr6130.c uses VIDEO mode and a different
+ * init sequence than Razer's (panel dtsi:69-130) -> nicole variant in
+ * drivers/panel/. Works since 2026-10-29 (DPU 7.0, DSC, command mode, TE).
+ */
+&mdss {
+	status = "okay";
+};
+
+/*
+ * dispcc reprograms the display PLLs at probe, which kills the picture ABL
+ * left running (2026-10-25: green flash, then black). Since 2026-10-29 msm
+ * DRM + the vtdr6130 nicole panel variant take over (simpledrm until then).
+ */
+&dispcc {
+	status = "okay";
+};
+
+&mdss_dsi0 {
+	vdda-supply = <&pm8350_l6>;	/* display/lahaina-sde.dtsi:90 vdda-1p2 = L6B */
+	status = "okay";
+
+	panel@0 {
+		/* drivers/panel/0001-drm-panel-visionox-vtdr6130-razer-nicole.patch */
+		compatible = "visionox,vtdr6130-razer-nicole";
+		reg = <0>;
+
+		pinctrl-0 = <&sde_dsi_active>, <&sde_te_active>;
+		pinctrl-1 = <&sde_dsi_suspend>, <&sde_te_active>;
+		pinctrl-names = "default", "sleep";
+
+		/*
+		 * Supplies (nicole variant of the binding, see patch):
+		 *  vddio = L12C (sde-display.dtsi:98, 1.86 V nicole.dtsi:302-305)
+		 *  vci   = L13C (downstream "vdd" 3.0 V, sde-display.dtsi:99)
+		 *  avdd  = downstream "avdd" GPIO13 switch (nicole.dtsi:295-316).
+		 *          No separate 1.2 V "vdd" rail on nicole, unlike sm8550-qrd.
+		 *          TODO(cihaz): confirm which rail GPIO13 really switches.
+		 */
+		vddio-supply = <&pm8350c_l12>;
+		vci-supply = <&pm8350c_l13>;
+		avdd-supply = <&panel_avdd>;
+
+		reset-gpios = <&tlmm 24 GPIO_ACTIVE_LOW>;
+
+		/*
+		 * panel dtsi:40 qcom,mdss-dsi-panel-orientation = "180". Kept as the
+		 * truth about the hardware, but the device cmdline overrides it with
+		 * video=DSI-1:panel_orientation=normal: from this property the fbdev
+		 * console put a 180° rotation on its plane (plane-0), and sway never
+		 * clears it. The panel looked upright only while it scanned out of
+		 * plane-0; when DP took crtc-0 first, the panel turned upside down
+		 * (1 Kasım). Now sway alone rotates (transforms in device-razer-nicole).
+		 */
+		rotation = <180>;
+
+		port {
+			panel0_in: endpoint {
+				remote-endpoint = <&mdss_dsi0_out>;
+			};
+		};
+	};
+};
+
+&mdss_dsi0_out {
+	remote-endpoint = <&panel0_in>;
+	data-lanes = <0 1 2 3>;
+	/* Command mode, TE on GPIO82 (mdp_vsync), see docs/panel-analizi.md */
+	qcom,te-source = "mdp_vsync_p";
+};
+
+&mdss_dsi0_phy {
+	/*
+	 * lahaina-sde.dtsi:91 says L1B, but :267 overrides mdss_dsi_phy0
+	 * vdda-0p9-supply = <&L5B>, which is what nicole uses.
+	 */
+	vdds-supply = <&pm8350_l5>;
+	status = "okay";
+};
+
+/*
+ * PHASE 3: QCA6490 on PCIe0 (cnss qcom,wlan-rc-num = <0>,
+ * lahaina.dtsi:5386). PERST 94, CLKREQ 95, WAKE 96 (pinctrl:2895-2930,
+ * lahaina-pcie.dtsi:38-39). PCIe supplies L5B/L6B (lahaina-pcie.dtsi:49-50).
+ */
+&pcie0 {
+	perst-gpios = <&tlmm 94 GPIO_ACTIVE_LOW>;
+	wake-gpios = <&tlmm 96 GPIO_ACTIVE_HIGH>;
+
+	pinctrl-0 = <&pcie0_default_state>;
+	pinctrl-names = "default";
+
+	/* mainline sm8350.dtsi has no paths here; same NoC-stall risk as MDP/SDHC */
+	interconnects = <&aggre2_noc MASTER_PCIE_0 0 &mc_virt SLAVE_EBI1 0>,
+			<&gem_noc MASTER_APPSS_PROC 0 &config_noc SLAVE_PCIE_0 0>;
+	interconnect-names = "pcie-mem", "cpu-pcie";
+
+	status = "okay";
+
+	pcie@0 {
+		/* QCA6490 enumerates as WCN6855 hw2.1 (ath11k pci.c 0x1103).
+		 * TODO(cihaz): confirm PCI ID with lspci/sysfs on Android. */
+		wifi@0 {
+			compatible = "pci17cb,1103";
+			reg = <0x10000 0x0 0x0 0x0 0x0>;
+
+			vddrfacmn-supply = <&vreg_pmu_rfa_cmn_0p8>;
+			vddaon-supply = <&vreg_pmu_aon_0p8>;
+			vddwlcx-supply = <&vreg_pmu_wlcx_0p8>;
+			vddwlmx-supply = <&vreg_pmu_wlmx_0p8>;
+			vddpcie1p8-supply = <&vreg_pmu_pcie_1p8>;
+			vddpcie0p9-supply = <&vreg_pmu_pcie_0p9>;
+			vddrfa0p8-supply = <&vreg_pmu_rfa_0p8>;
+			vddrfa1p2-supply = <&vreg_pmu_rfa_1p2>;
+			vddrfa1p8-supply = <&vreg_pmu_rfa_1p7>;
+		};
+	};
+};
+
+&pcie0_phy {
+	vdda-phy-supply = <&pm8350_l5>;
+	vdda-pll-supply = <&pm8350_l6>;
+	status = "okay";
+};
+
+/*
+ * pcie1 stays disabled: downstream it carries wil6210 (qrd-common:224-226,
+ * lahaina.dtsi:5662-5664) or, on the 5G SKU, probably the Quectel modem.
+ * nicole only tweaks it (nicole.dtsi:981-984). TODO(cihaz): lspci.
+ */
+
+&pm8350_gpios {
+	/* pmic-overlay:12-19 */
+	vol_up_n: vol-up-n-state {
+		pins = "gpio6";
+		function = "normal";
+		power-source = <1>;
+		bias-pull-up;
+		input-enable;
+	};
+
+	/* pmic-overlay:22-29 (used by joystick_usb_vbus, PHASE 3) */
+	joystick_vbus_en: joystick-vbus-en-state {
+		pins = "gpio8";
+		function = "normal";
+		power-source = <0>;
+		output-low;
+	};
+};
+
+/*
+ * Read-only ADC channels, enabled in phase 2 so that board temperatures
+ * can be logged (docs/guvenlik-kurallari.md section 3). Channels and labels from
+ * pmic-overlay:285-361 and nicole.dtsi:608-616.
+ */
+&pmk8350_vadc {
+	channel@44 {
+		reg = <PMK8350_ADC7_AMUX_THM1_100K_PU>;
+		qcom,ratiometric;
+		qcom,hw-settle-time = <200>;
+		qcom,pre-scaling = <1 1>;
+		label = "pmk8350_xo_therm";
+	};
+
+	channel@144 {
+		reg = <PM8350_ADC7_AMUX_THM1_100K_PU(1)>;
+		qcom,ratiometric;
+		qcom,hw-settle-time = <200>;
+		qcom,pre-scaling = <1 1>;
+		label = "pm8350_msm_therm";
+	};
+
+	/* "quiet therm" used by the fan zone quiet-therm-step
+	 * (nicole.dtsi:835-909) */
+	channel@145 {
+		reg = <PM8350_ADC7_AMUX_THM2_100K_PU(1)>;
+		qcom,ratiometric;
+		qcom,hw-settle-time = <200>;
+		qcom,pre-scaling = <1 1>;
+		label = "pm8350_quiet_therm";
+	};
+
+	channel@147 {
+		reg = <PM8350_ADC7_AMUX_THM4_100K_PU(1)>;
+		qcom,ratiometric;
+		qcom,hw-settle-time = <200>;
+		qcom,pre-scaling = <1 1>;
+		label = "pm8350_wide_rfc_therm";
+	};
+
+	channel@148 {
+		reg = <PM8350_ADC7_AMUX_THM5_100K_PU(1)>;
+		qcom,ratiometric;
+		qcom,hw-settle-time = <200>;
+		qcom,pre-scaling = <1 1>;
+		label = "pm8350_rear_tof_therm";
+	};
+
+	/* nicole.dtsi:608-616 */
+	channel@346 {
+		reg = <PM8350B_ADC7_AMUX_THM3_100K_PU>;
+		qcom,ratiometric;
+		qcom,hw-settle-time = <200>;
+		qcom,pre-scaling = <1 1>;
+		label = "pm8350b_smb_temp_therm";
+	};
+
+	channel@347 {
+		reg = <PM8350B_ADC7_AMUX_THM4_100K_PU>;
+		qcom,ratiometric;
+		qcom,hw-settle-time = <200>;
+		qcom,pre-scaling = <1 1>;
+		label = "pm8350b_usb_conn_therm";
+	};
+};
+
+/* PHASE 3: ADC thermal monitor for the fan "quiet" zone */
+&pmk8350_adc_tm {
+	status = "disabled";
+
+	quiet-therm@0 {
+		reg = <0>;
