+/*
+ * microSD = phase-2 rootfs.
+ * nicole.dtsi:286-293: cd-gpios GPIO80 ACTIVE_HIGH (overrides GPIO92
+ * ACTIVE_LOW of qrd-common:53). Supplies qrd-common:40-47.
+ * TODO(cihaz): verify CD polarity (gpioinfo / card insert); if wrong,
+ * flip the flag or temporarily use broken-cd.
+ */
+/*
+ * sdhci-msm votes its interconnect paths through the OPP table, but the
+ * sm8350.dtsi OPPs carry no bandwidth, so the SD card (our root fs) has no
+ * vote at all: once the interconnect providers reach sync_state() the
+ * aggre2 path (BCM SN8, not keepalive) drops to 0 and root fs I/O stalls.
+ * Values from Razer's downstream lahaina.dtsi:3199-3214 msm-bus vectors
+ * (ab = avg, ib = peak; sdhc-ddr, cpu-sdhc): 100 MB/s and 200 MB/s cases.
+ */
+&sdhc2_opp_table {
+	opp-100000000 {
+		opp-peak-kBps = <200000 150000>;
+		opp-avg-kBps = <261438 150000>;
+	};
+
+	opp-202000000 {
+		opp-peak-kBps = <400000 300000>;
+		opp-avg-kBps = <261438 300000>;
+	};
+};
+
+&sdhc_2 {
+	cd-gpios = <&tlmm 80 GPIO_ACTIVE_HIGH>;
+
+	pinctrl-0 = <&sdc2_default_state>, <&sdc2_card_det_n>;
+	pinctrl-1 = <&sdc2_sleep_state>, <&sdc2_card_det_sleep>;
+	pinctrl-names = "default", "sleep";
+
+	vmmc-supply = <&pm8350c_l9>;
+	vqmmc-supply = <&pm8350c_l6>;
+
+	no-sdio;
+	no-mmc;
+
+	/*
+	 * DLL settings: Razer qcom,dll-hsr-list (lahaina.dtsi:3233) dll_config /
+	 * ddr_config, same as mainline sm8250. Missing in mainline sm8350.dtsi; without
+	 * them SDR104 (202 MHz) writes corrupted the first ~250 MB of the pmOS image on
+	 * the card with no host error, reads then differed on every pass (2026-10-25).
+	 */
+	qcom,dll-config = <0x0007642c>;
+	qcom,ddr-config = <0x80040868>;
+	/*
+	 * With these, SDR104 at 202 MHz passed scripts/lab/cihazda/sd-stres.sh twice
+	 * (1 GiB random + 300 MiB zeros, uncached re-reads; 44 MB/s write, 64 MB/s read).
+	 */
+
+	status = "okay";
+};
+
+/* Razer drive strengths: cmd/data 10 mA (pinctrl:106-116, mainline 16) */
+&sdc2_default_state {
+	cmd-pins {
+		drive-strength = <10>;
+	};
+
+	data-pins {
+		drive-strength = <10>;
+	};
+};
+
+/*
+ * PHASE 3: touchscreen. nicole.dtsi:141-164: FocalTech FTS (FT3658S)
+ * on qupv3_se12_spi (= mainline spi12 @a90000), CS0, 6 MHz,
+ * IRQ GPIO23 (0x2008 = falling | oneshot), reset GPIO22,
+ * vdd L3C, vcc_i2c L8C, 10 touches, 1080x2400.
+ * Driver: drivers/touchscreen/focaltech_ft3658s_spi.c (own, from Razer's vendor driver).
+ */
+&spi12 {
+	pinctrl-0 = <&qup_spi12_default>;
+	pinctrl-names = "default";
+
+	status = "okay";
+
+	touchscreen@0 {
+		compatible = "focaltech,ft3658s";
+		reg = <0>;
+		spi-max-frequency = <6000000>;
+
+		interrupts-extended = <&tlmm 23 IRQ_TYPE_EDGE_FALLING>;
+		reset-gpios = <&tlmm 22 GPIO_ACTIVE_LOW>;
+
+		vdd-supply = <&pm8350c_l3>;
+		iovdd-supply = <&pm8350c_l8>;
+
+		pinctrl-0 = <&ts_active>;
+		pinctrl-names = "default";
+
+		touchscreen-size-x = <1080>;
+		touchscreen-size-y = <2400>;
+		/*
+		 * The digitizer reports in the panel's own scanout coordinates, so
+		 * no inversion: the compositor's output transform turns touch with
+		 * the picture. (Until 1 Kasım touchscreen-inverted-x/y were set; they
+		 * only made up for the console's leftover plane rotation, see the
+		 * panel node.)
+		 */
+	};
+};
