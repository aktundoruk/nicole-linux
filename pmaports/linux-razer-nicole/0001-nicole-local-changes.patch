 dtb-$(CONFIG_ARCH_QCOM)	+= x1p42100-microsoft-sp12in.dtb x1p42100-microsoft-sp12in-el2.dtb
+
+# Razer Edge Wi-Fi (nicole) - added by scripts/build/build-kernel.sh
+dtb-$(CONFIG_ARCH_QCOM)	+= sm8350-razer-nicole.dtb
+DTC_FLAGS_sm8350-razer-nicole := -@
diff --git a/arch/arm64/boot/dts/qcom/sm8350-nicole-camss.dtsi b/arch/arm64/boot/dts/qcom/sm8350-nicole-camss.dtsi
new file mode 100644
index 000000000..212dc37c9
--- /dev/null
+++ b/arch/arm64/boot/dts/qcom/sm8350-nicole-camss.dtsi
@@ -0,0 +1,281 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * SM8350 CAMSS node for the Razer Edge (nicole), stage 2 of the front
+ * camera (6 Kasım 2026, first used in kernel r22). Needs the kernel patches
+ * drivers/camera/0003-media-qcom-camss-add-SM8350-support.patch and
+ * drivers/camera/0004-dt-bindings-media-add-qcom-sm8350-camss.patch.
+ *
+ * Included at the very end of
+ * sm8350-razer-nicole.dts (it needs the camcc, hi556_ep, pm8350_l5 and
+ * pm8350_l6 labels defined there). The first part is what would go into
+ * sm8350.dtsi upstream (status = "disabled"), the second part is the board
+ * part.
+ *
+ * Sources: Razer downstream camera/lahaina-camera.dtsi (csiphy0-5, csid0-2,
+ * ife0-2, csid-lite0/1, ife-lite0/1, qcom,cam-cpas, qcom,cam_smmu) and
+ * camera/lahaina-camera-sensor-nicole.dtsi (csiphy-sd-index = 5).
+ * Anything marked GUESS is not taken from a Razer/Qualcomm source.
+ */
+
+&soc {
+	camss: isp@ac6a000 {
+		compatible = "qcom,sm8350-camss";
+
+		/*
+		 * CSIPHY sizes as downstream (0x2000 each). VFE regions as
+		 * downstream "ife"/"ife-lite" regs; they contain the CSIDs
+		 * (CSIDn = IFEn + 0x1200, CSID-lite = IFE-lite + 0x200, same
+		 * layout as SM8250/Titan 480), so no separate csid regs.
+		 */
+		reg = <0x0 0x0ac6a000 0x0 0x2000>,
+		      <0x0 0x0ac6c000 0x0 0x2000>,
+		      <0x0 0x0ac6e000 0x0 0x2000>,
+		      <0x0 0x0ac70000 0x0 0x2000>,
+		      <0x0 0x0ac72000 0x0 0x2000>,
+		      <0x0 0x0ac74000 0x0 0x2000>,
+		      <0x0 0x0acb4000 0x0 0xd000>,
+		      <0x0 0x0acc3000 0x0 0xd000>,
+		      <0x0 0x0acef000 0x0 0xd000>,
+		      <0x0 0x0acd9000 0x0 0x2200>,
+		      <0x0 0x0acdb200 0x0 0x2200>;
+		reg-names = "csiphy0",
+			    "csiphy1",
+			    "csiphy2",
+			    "csiphy3",
+			    "csiphy4",
+			    "csiphy5",
+			    "vfe0",
+			    "vfe1",
+			    "vfe2",
+			    "vfe_lite0",
+			    "vfe_lite1";
+
+		/*
+		 * GCC_CAMERA_AHB_CLK is not listed: mainline gcc-sm8350 keeps it
+		 * always on and does not export it.
+		 */
+		clocks = <&gcc GCC_CAMERA_HF_AXI_CLK>,
+			 <&gcc GCC_CAMERA_SF_AXI_CLK>,
+			 <&camcc CAM_CC_CAMNOC_AXI_CLK>,
+			 <&camcc CAM_CC_CAMNOC_AXI_CLK_SRC>,
+			 <&camcc CAM_CC_CORE_AHB_CLK>,
+			 <&camcc CAM_CC_CPAS_AHB_CLK>,
+			 <&camcc CAM_CC_CSIPHY0_CLK>,
+			 <&camcc CAM_CC_CSI0PHYTIMER_CLK>,
+			 <&camcc CAM_CC_CSIPHY1_CLK>,
+			 <&camcc CAM_CC_CSI1PHYTIMER_CLK>,
+			 <&camcc CAM_CC_CSIPHY2_CLK>,
+			 <&camcc CAM_CC_CSI2PHYTIMER_CLK>,
+			 <&camcc CAM_CC_CSIPHY3_CLK>,
+			 <&camcc CAM_CC_CSI3PHYTIMER_CLK>,
+			 <&camcc CAM_CC_CSIPHY4_CLK>,
+			 <&camcc CAM_CC_CSI4PHYTIMER_CLK>,
+			 <&camcc CAM_CC_CSIPHY5_CLK>,
+			 <&camcc CAM_CC_CSI5PHYTIMER_CLK>,
+			 <&camcc CAM_CC_SLOW_AHB_CLK_SRC>,
+			 <&camcc CAM_CC_IFE_0_AHB_CLK>,
+			 <&camcc CAM_CC_IFE_0_AXI_CLK>,
+			 <&camcc CAM_CC_IFE_0_CLK>,
+			 <&camcc CAM_CC_IFE_0_CPHY_RX_CLK>,
+			 <&camcc CAM_CC_IFE_0_CSID_CLK>,
+			 <&camcc CAM_CC_IFE_0_AREG_CLK>,
+			 <&camcc CAM_CC_IFE_1_AHB_CLK>,
+			 <&camcc CAM_CC_IFE_1_AXI_CLK>,
+			 <&camcc CAM_CC_IFE_1_CLK>,
+			 <&camcc CAM_CC_IFE_1_CPHY_RX_CLK>,
+			 <&camcc CAM_CC_IFE_1_CSID_CLK>,
+			 <&camcc CAM_CC_IFE_1_AREG_CLK>,
+			 <&camcc CAM_CC_IFE_2_AHB_CLK>,
+			 <&camcc CAM_CC_IFE_2_AXI_CLK>,
+			 <&camcc CAM_CC_IFE_2_CLK>,
+			 <&camcc CAM_CC_IFE_2_CPHY_RX_CLK>,
+			 <&camcc CAM_CC_IFE_2_CSID_CLK>,
+			 <&camcc CAM_CC_IFE_2_AREG_CLK>,
+			 <&camcc CAM_CC_IFE_LITE_AHB_CLK>,
+			 <&camcc CAM_CC_IFE_LITE_AXI_CLK>,
+			 <&camcc CAM_CC_IFE_LITE_CLK>,
+			 <&camcc CAM_CC_IFE_LITE_CPHY_RX_CLK>,
+			 <&camcc CAM_CC_IFE_LITE_CSID_CLK>;
+		clock-names = "cam_hf_axi",
+			      "cam_sf_axi",
+			      "camnoc_axi",
+			      "camnoc_axi_src",
+			      "core_ahb",
+			      "cpas_ahb",
+			      "csiphy0",
+			      "csiphy0_timer",
+			      "csiphy1",
+			      "csiphy1_timer",
+			      "csiphy2",
+			      "csiphy2_timer",
+			      "csiphy3",
+			      "csiphy3_timer",
+			      "csiphy4",
+			      "csiphy4_timer",
+			      "csiphy5",
+			      "csiphy5_timer",
+			      "slow_ahb_src",
+			      "vfe0_ahb",
+			      "vfe0_axi",
+			      "vfe0",
+			      "vfe0_cphy_rx",
+			      "vfe0_csid",
+			      "vfe0_areg",
+			      "vfe1_ahb",
+			      "vfe1_axi",
+			      "vfe1",
+			      "vfe1_cphy_rx",
+			      "vfe1_csid",
+			      "vfe1_areg",
+			      "vfe2_ahb",
+			      "vfe2_axi",
+			      "vfe2",
+			      "vfe2_cphy_rx",
+			      "vfe2_csid",
+			      "vfe2_areg",
+			      "vfe_lite_ahb",
+			      "vfe_lite_axi",
+			      "vfe_lite",
+			      "vfe_lite_cphy_rx",
+			      "vfe_lite_csid";
+
+		interrupts = <GIC_SPI 477 IRQ_TYPE_EDGE_RISING>,
+			     <GIC_SPI 478 IRQ_TYPE_EDGE_RISING>,
+			     <GIC_SPI 479 IRQ_TYPE_EDGE_RISING>,
+			     <GIC_SPI 448 IRQ_TYPE_EDGE_RISING>,
+			     <GIC_SPI 122 IRQ_TYPE_EDGE_RISING>,
+			     <GIC_SPI 89 IRQ_TYPE_EDGE_RISING>,
+			     <GIC_SPI 464 IRQ_TYPE_EDGE_RISING>,
+			     <GIC_SPI 466 IRQ_TYPE_EDGE_RISING>,
+			     <GIC_SPI 640 IRQ_TYPE_EDGE_RISING>,
+			     <GIC_SPI 468 IRQ_TYPE_EDGE_RISING>,
+			     <GIC_SPI 359 IRQ_TYPE_EDGE_RISING>,
+			     <GIC_SPI 465 IRQ_TYPE_EDGE_RISING>,
+			     <GIC_SPI 467 IRQ_TYPE_EDGE_RISING>,
+			     <GIC_SPI 641 IRQ_TYPE_EDGE_RISING>,
+			     <GIC_SPI 469 IRQ_TYPE_EDGE_RISING>,
+			     <GIC_SPI 360 IRQ_TYPE_EDGE_RISING>;
+		interrupt-names = "csiphy0",
+				  "csiphy1",
+				  "csiphy2",
+				  "csiphy3",
+				  "csiphy4",
+				  "csiphy5",
+				  "csid0",
+				  "csid1",
+				  "csid2",
+				  "csid_lite0",
+				  "csid_lite1",
+				  "vfe0",
+				  "vfe1",
+				  "vfe2",
+				  "vfe_lite0",
+				  "vfe_lite1";
+
+		/*
+		 * Paths from the downstream cpas node: cam_ahb (APPSS ->
+		 * CAMERA_CFG), cam_hf_0, cam_sf_0, cam_sf_icp (CAMNOC -> EBI1).
+		 * The tags follow the iris node in sm8350.dtsi (GUESS).
+		 */
+		interconnects = <&gem_noc MASTER_APPSS_PROC QCOM_ICC_TAG_ACTIVE_ONLY
+				 &config_noc SLAVE_CAMERA_CFG QCOM_ICC_TAG_ACTIVE_ONLY>,
+				<&mmss_noc MASTER_CAMNOC_HF QCOM_ICC_TAG_ALWAYS
+				 &mc_virt SLAVE_EBI1 QCOM_ICC_TAG_ALWAYS>,
+				<&mmss_noc MASTER_CAMNOC_SF QCOM_ICC_TAG_ALWAYS
+				 &mc_virt SLAVE_EBI1 QCOM_ICC_TAG_ALWAYS>,
+				<&mmss_noc MASTER_CAMNOC_ICP QCOM_ICC_TAG_ALWAYS
+				 &mc_virt SLAVE_EBI1 QCOM_ICC_TAG_ALWAYS>;
+		interconnect-names = "ahb",
+				     "hf_mnoc",
+				     "sf_mnoc",
+				     "sf_icp_mnoc";
+
+		/*
+		 * As downstream msm_cam_smmu_ife ("ife", "ife-cdm"). With mask 0x440
+		 * the four entries collapse into one SMR: 0x800, 0x840, 0xc00, 0xc40.
+		 * The hypervisor only lets HLOS install the stream match it expects:
+		 * the sm8250-style list (0x800/0x801/0x840/0x841 ... mask 0x400) left
+		 * the four SMRs invalid while their S2CRs pointed at the context bank,
+		 * so the first VFE write was an unmatched stream and the SoC reset
+		 * (6 Kasım). 0x84400800 written by hand into SMR13 fixed it.
+		 */
+		iommus = <&apps_smmu 0x800 0x440>,
+			 <&apps_smmu 0x840 0x440>,
+			 <&apps_smmu 0xc00 0x440>,
+			 <&apps_smmu 0xc40 0x440>;
+
+		power-domains = <&camcc IFE_0_GDSC>,
+				<&camcc IFE_1_GDSC>,
+				<&camcc IFE_2_GDSC>,
+				<&camcc TITAN_TOP_GDSC>;
+		power-domain-names = "ife0",
+				     "ife1",
+				     "ife2",
+				     "top";
+
+		status = "disabled";
+
+		ports {
+			#address-cells = <1>;
+			#size-cells = <0>;
+
+			port@0 {
+				reg = <0>;
+			};
+
+			port@1 {
+				reg = <1>;
+			};
+
+			port@2 {
+				reg = <2>;
+			};
+
+			port@3 {
+				reg = <3>;
+			};
+
+			port@4 {
+				reg = <4>;
+			};
+
+			port@5 {
+				reg = <5>;
+			};
+		};
+	};
+};
+
+/* ---- board part (sm8350-razer-nicole.dts) ---- */
+
+&camss {
+	/*
+	 * Downstream csiphy0-5: csi-vdd-0p9 = pm8350_l5 (0.88 V, 96.4 mA),
+	 * csi-vdd-1p2 = pm8350_l6 (1.2 V, 54 mA). Both rails are already on
+	 * (fixed HPM) for the USB/UFS/DSI PHYs in our DTS.
+	 */
+	vdda-phy-supply = <&pm8350_l5>;
+	vdda-pll-supply = <&pm8350_l6>;
+
+	status = "okay";
+
+	ports {
+		/* Hi-556 front camera, csiphy-sd-index = 5 downstream */
+		port@5 {
+			camss_csiphy5_ep: endpoint {
+				/*
+				 * GUESS: the sensor uses PHY data lanes 0 and 1.
+				 * The downstream nicole sensor dtsi gives only the
+				 * PHY index, no lane map. D-PHY is the default bus
+				 * type; clock-lanes is not used by CAMSS gen2 PHYs.
+				 */
+				data-lanes = <0 1>;
+				remote-endpoint = <&hi556_ep>;
+			};
+		};
+	};
+};
+
+&hi556_ep {
+	remote-endpoint = <&camss_csiphy5_ep>;
+};
diff --git a/arch/arm64/boot/dts/qcom/sm8350-razer-nicole.dts b/arch/arm64/boot/dts/qcom/sm8350-razer-nicole.dts
new file mode 100644
index 000000000..fcfac8c5a
--- /dev/null
+++ b/arch/arm64/boot/dts/qcom/sm8350-razer-nicole.dts
@@ -0,0 +1,2878 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * Razer Edge Wi-Fi (RZ80-0461, codename "nicole")
+ * Qualcomm SM8350 ("lahainap", marketed as Snapdragon G3x Gen 1), 6 GB RAM
+ *
+ * DRAFT mainline device tree - written before the device was connected.
+ * Base structure follows sm8350-hdk.dts and sm8350-sony-xperia-sagami.dtsi.
+ *
+ * Source references (all paths relative to the Razer/LineageOS 5.4 kernel,
+ * arch/arm64/boot/dts/vendor/qcom/ unless stated otherwise):
+ *   nicole.dtsi   = lahainap-nicole.dtsi        (board file)
+ *   qrd-common    = lahaina-qrd-common.dtsi     (included by nicole.dtsi:2)
+ *   pmic-overlay  = lahaina-pmic-overlay.dtsi   (included by qrd-common:7)
+ *   regulators    = lahaina-regulators.dtsi
+ *   lahaina.dtsi  = SoC file (via lahainap.dtsi / lahainap-v2(.1).dtsi)
+ *   pinctrl       = lahaina-pinctrl.dtsi
+ * Effective downstream DT = lahainap*.dtb (base) + lahainap-nicole-overlay.dtbo
+ * (Makefile:1-6, nicole.config CONFIG_BUILD_ARM64_DT_OVERLAY=y).
+ *
+ * PHASE RULES
+ *   Phase 2 (first boot): microSD rootfs, USB gadget networking, simple-
+ *   framebuffer console, buttons, remoteprocs. Internal UFS is DISABLED.
+ *   Phase 3 nodes are present but status = "disabled" and marked PHASE 3.
+ *
+ * Anything marked TODO(cihaz) must be confirmed on the real device
+ * (Phase 0 /sys/firmware/fdt dump, i2cdetect, gpioinfo, ...).
+ */
+
+/dts-v1/;
+
+#include <dt-bindings/clock/qcom,lpassaudiocc-sc7280.h>
+#include <dt-bindings/clock/qcom,sm8350-camcc.h>
+#include <dt-bindings/gpio/gpio.h>
+#include <dt-bindings/iio/qcom,spmi-adc7-pm8350.h>
+#include <dt-bindings/iio/qcom,spmi-adc7-pm8350b.h>
+#include <dt-bindings/iio/qcom,spmi-adc7-pmk8350.h>
+#include <dt-bindings/input/input.h>
+#include <dt-bindings/regulator/qcom,rpmh-regulator.h>
+#include "sm8350.dtsi"
+#include "pm8350.dtsi"
+#include "pm8350b.dtsi"
+#include "pm8350c.dtsi"
+#include "pmk8350.dtsi"
+#include "pmr735a.dtsi"
+#include "pmr735b.dtsi"
+
+/ {
+	model = "Razer Edge Wi-Fi";
+	compatible = "razer,nicole", "qcom,sm8350";
+	chassis-type = "handset";
+
+	/*
+	 * ABL applies the Gunyah hypervisor's DTBOs on top of the DTB, and they
+	 * reference the label "arch_timer" (Qualcomm's lahaina DT has it on the
+	 * armv8 timer). Without it the overlay step fails and ABL drops to
+	 * fastboot without a word (found 2026-10-25 by bisecting the __symbols__
+	 * of LineageOS' SoC DTB, lab log). Build with -@.
+	 */
+	arch_timer: timer {
+	};
+
+	/*
+	 * Downstream IDs: qcom,msm-id = <439 0x20001> (lahainap-v2.1.dtsi:6,
+	 * 439 = QCOM_ID_SM8350 in mainline qcom,ids.h) and
+	 * qcom,board-id = <0x1001f 0x02> (lahainap-nicole-overlay.dts:9).
+	 * Sagami notes that adding msm/board-id on SM8350 can upset ABL, so they
+	 * are left out on purpose. TODO(cihaz): if ABL refuses the DTB in
+	 * "fastboot boot", try uncommenting these two lines:
+	 *
+	 * qcom,msm-id = <439 0x20001>;
+	 * qcom,board-id = <0x1001f 0x02>;
+	 */
+
+	aliases {
+		/* QUP SE3 debug UART @98c000, GPIO18/19 (lahaina-qupv3.dtsi:72-85,
+		 * lahaina.dtsi:46 serial0). TODO(cihaz): test pads unknown. */
+		serial0 = &uart2;
+		mmc1 = &sdhc_2;
+	};
+
+	chosen {
+		#address-cells = <2>;
+		#size-cells = <2>;
+		ranges;
+
+		/*
+		 * Kernel messages go to the debug UART (if pads are reachable);
+		 * add "console=tty0" to the cmdline so the framebuffer console
+		 * gets them too (see docs/dts-notlari.md).
+		 */
+		stdout-path = "serial0:115200n8";
+
+		/*
+		 * Bootloader continuous-splash framebuffer.
+		 * Region: splash_memory "cont_splash_region" reg <0xe1000000 0x2300000>
+		 * (lahaina.dtsi:516-519); disp_rdump_region uses the same base
+		 * (display/lahaina-sde.dtsi:5-8). Panel is 1080x2400
+		 * (display/dsi-panel-vtdr6130-dsc-fhd-plus-144hz-cmd.dtsi:54-55).
+		 * 1080*2400*4 = 0x9e3400 bytes fits in the region.
+		 * TODO(cihaz): verify format (a8r8g8b8 vs x8r8g8b8/r8g8b8) and
+		 * stride (no padding assumed) by checking the picture on screen.
+		 * The panel is mounted rotated (downstream qcom,mdss-dsi-panel-
+		 * orientation = "180", panel dtsi:40; Android boots landscape,
+		 * vendor.prop:101 ORIENTATION_90) -> use fbcon=rotate:N.
+		 */
+		framebuffer0: framebuffer@e1000000 {
+			compatible = "simple-framebuffer";
+			reg = <0x0 0xe1000000 0x0 0x2300000>;
+			width = <1080>;
+			height = <2400>;
+			stride = <(1080 * 4)>;
+			format = "a8r8g8b8";
+
+			/*
+			 * Keep the display path alive until a real DRM driver
+			 * takes over: AXI clocks, MDSS GDSC (keeps MMCX up through
+			 * the genpd hierarchy) and every rail the panel + DSI need,
+			 * otherwise regulator/genpd/rpmhpd cleanup ~30 s after boot
+			 * blanks the screen.
+			 */
+			clocks = <&gcc GCC_DISP_HF_AXI_CLK>,
+				 <&gcc GCC_DISP_SF_AXI_CLK>;
+			/*
+			 * MMCX directly, not <&dispcc MDSS_GDSC>: dispcc stays disabled
+			 * (see &dispcc below), the bootloader leaves MDSS_GDSC on.
+			 * The HF TBUs carry the MDSS scanout through the SMMU; without
+			 * pd_ignore_unused nothing else keeps them on.
+			 */
+			power-domains = <&rpmhpd RPMHPD_MMCX>,
+					<&gcc HLOS1_VOTE_MMNOC_MMU_TBU_HF0_GDSC>,
+					<&gcc HLOS1_VOTE_MMNOC_MMU_TBU_HF1_GDSC>;
+			/*
+			 * MDP scanout paths (sm8350.dtsi &mdss "mdp0-mem"/"mdp1-mem").
+			 * Without a vote here the NoC stalls once the interconnect
+			 * providers reach sync_state() (lab log, 25 Ekim);
+			 * needs drivers/simpledrm/0001-...interconnect-bandwidth.patch.
+			 */
+			interconnects = <&mmss_noc MASTER_MDP0 0 &mc_virt SLAVE_EBI1 0>,
+					<&mmss_noc MASTER_MDP1 0 &mc_virt SLAVE_EBI1 0>;
+			vddio-supply = <&pm8350c_l12>;	/* panel vddio, display/lahaina-sde-display.dtsi:98 */
+			vci-supply = <&pm8350c_l13>;	/* panel vdd 3.0 V, display/lahaina-sde-display.dtsi:99 */
+			avdd-supply = <&panel_avdd>;	/* GPIO13 switch, nicole.dtsi:295-299 */
+			dsi-vdda-supply = <&pm8350_l6>;	/* DSI 1.2 V, display/lahaina-sde.dtsi:90 */
+			dsi-phy-supply = <&pm8350_l5>;	/* DSI PHY: lahaina-sde.dtsi:267 overrides :91 to L5B (0.88 V; downstream supply entry asks 0.912 V - TODO(cihaz): check regulators.txt) */
+		};
+	};
+
+	gpio-keys {
+		compatible = "gpio-keys";
+
+		pinctrl-0 = <&vol_up_n>;
+		pinctrl-names = "default";
+
+		/* qrd-common:306-323 vol_up = pm8350_gpios 6, active low */
+		key-vol-up {
+			label = "Volume Up";
+			linux,code = <KEY_VOLUMEUP>;
+			gpios = <&pm8350_gpios 6 GPIO_ACTIVE_LOW>;
+			debounce-interval = <15>;
+			linux,can-disable;
+			wakeup-source;
+		};
+	};
+
+	/*
+	 * Battery / charger through the ADSP (battery_charger, ucsi, altmode under
+	 * qcom,pmic_glink, lahaina.dtsi:5558-5581). Enabled 2026-10-25 with the
+	 * device's own adsp.mbn (Faz 3 extraction): qcom-battmgr reports status,
+	 * capacity, voltage, current, temp; the ADSP charges by itself.
+	 * Needs "qcom,sm8350" in the LIVE root compatible for the in-kernel PD mapper
+	 * (the dtbo overlay used to replace it, see make-bootimg.sh d5 dtbo).
+	 *
+	 * D2 deneme C (31 Ekim): the Type-C graph as sm8350-hdk.dts:41-82: SS to
+	 * usb_1_qmpphy (no redriver: NB7VPQ904M is QRD-only), SBU to the FSA4480,
+	 * orientation from GPIO81 usb3phy_portselect (pinctrl:3652-3678), mdss_dp
+	 * on two lanes. Razer's own DP node uses the same FSA4480 as AUX switch and
+	 * the ADSP altmode for HPD (display/lahaina-sde.dtsi sde_dp).
+	 */
+	pmic-glink {
+		compatible = "qcom,sm8350-pmic-glink", "qcom,pmic-glink";
+		#address-cells = <1>;
+		#size-cells = <0>;
+		/* GPIO81 usb3phy_portselect (pinctrl:3652-3678), as sm8350-hdk */
+		orientation-gpios = <&tlmm 81 GPIO_ACTIVE_HIGH>;
+
+		/*
+		 * Razer's OTG load switch (31 Ekim 2026): their 5.4 kernel drives
+		 * global GPIO 356 high on battmgr notification 0x91 / a UFP partner
+		 * and low on 0x90 (qti_battery_charger.c, ucsi.c). That is TLMM 48
+		 * (TLMM base 308), the "ocp,control-gpio" of their qcom_ocp node;
+		 * GPIO79 is the switch's active-low over-current flag, pulled up
+		 * (nicole.dtsi:347-358, 501-508, drivers/soc/qcom/ocp_irq.c).
+		 * Verified: a hub enumerates the moment 48 goes high and drops when
+		 * it goes low. Keep GPIO78 ("usb_charge_contrl") low: with it high
+		 * the hub never powered up. Consumer: drivers/typec ucsi_glink patch.
+		 */
+		otg-gpios = <&tlmm 48 GPIO_ACTIVE_HIGH>;
+		ocp-gpios = <&tlmm 79 GPIO_ACTIVE_LOW>;
+		pinctrl-0 = <&usb_otg_en>, <&usb_ocp_n>;
+		pinctrl-names = "default";
+
+		/*
+		 * With the Type-C graph (altmode on) the ADSP's charger detection
+		 * leaves the HS PHY non-driving, datapath overridden (CFG0 bit0,
+		 * UTMI_CTRL0 OPMODE=01), ~11 ms after every sink attach: the Mac
+		 * sees a dead device. ucsi_glink hands the datapath back through
+		 * this PHY (31 Ekim 2026, measured with a 10 ms register watch).
+		 */
+		phys = <&usb_1_hsphy>;
+		phy-names = "usb2";
+
+		connector@0 {
+			compatible = "usb-c-connector";
+			reg = <0>;
+			power-role = "dual";
+			data-role = "dual";
+
+			ports {
+				#address-cells = <1>;
+				#size-cells = <0>;
+
+				/*
+				 * No HS endpoint: wired to dwc3 it hands UCSI the role
+				 * switch and device mode stalls (D1 deneme 1, D2 deneme
+				 * C/E, 31 Ekim). nicole-usb-rol copies the role instead.
+				 */
+				port@0 {
+					reg = <0>;
+				};
+
+				port@1 {
+					reg = <1>;
+
+					pmic_glink_ss_in: endpoint {
+						remote-endpoint = <&usb_1_qmpphy_out>;
+					};
+				};
+
+				port@2 {
+					reg = <2>;
+
+					pmic_glink_sbu: endpoint {
+						remote-endpoint = <&fsa4480_sbu_mux>;
+					};
+				};
+			};
+		};
+	};
+
+	reserved-memory {
+		/*
+		 * All fixed carveouts of Razer's lahaina.dtsi:293-417 match
+		 * mainline sm8350.dtsi:425-555 byte for byte (hyp, xbl_aop,
+		 * cmd_db, smem, cpucp, cdsp_secure_heap, camera, video, cvp,
+		 * adsp 0x86100000+0x2100000, slpi 0x88200000+0x1500000,
+		 * cdsp 0x89700000+0x1e00000, ipa fw/gsi, gpu 0x8b51a000+0x2000,
+		 * spss, modem 0x8b800000+0x10000000, hyp_reserved, trustedvm,
+		 * qrtr/neuron shbufs, removed_mem). Only display regions are added
+		 * here; rmtfs is handled below (&rmtfs_mem).
+		 */
+
+		/* lahaina.dtsi:516-519 (downstream has no no-map; we must not
+		 * let Linux allocate the live scanout buffer) */
+		cont_splash_mem: memory@e1000000 {
+			reg = <0x0 0xe1000000 0x0 0x2300000>;
+			no-map;
+		};
+
+		/* lahaina.dtsi:535-538 dfps_data_region, written by ABL */
+		dfps_data_mem: memory@e3300000 {
+			reg = <0x0 0xe3300000 0x0 0x100000>;
+			no-map;
+		};
+
+		/*
+		 * Crash log across a warm reset (pstore). Razer's DT has no such
+		 * region; 0xffc00000 is what the other sm8350 phone in mainline
+		 * uses (sm8350-sony-xperia-sagami.dtsi). On nicole it is plain
+		 * System RAM (in Linux's CMA area, which simply moves). Added for
+		 * the first suspend test (30 Ekim): the phone reset with no log.
+		 */
+		ramoops@ffc00000 {
+			compatible = "ramoops";
+			reg = <0x0 0xffc00000 0x0 0x100000>;
+			record-size = <0x10000>;
+			console-size = <0x40000>;
+			pmsg-size = <0x20000>;
+			ecc-size = <16>;
+			no-map;
+		};
+	};
+
+	vph_pwr: vph-pwr-regulator {
+		compatible = "regulator-fixed";
+		regulator-name = "vph_pwr";
+		regulator-min-microvolt = <3700000>;
+		regulator-max-microvolt = <3700000>;
+
+		regulator-always-on;
+		regulator-boot-on;
+	};
+
+	/*
+	 * Panel AVDD load switch. Downstream: "display_panel_avdd" 5.5 V
+	 * (display/lahaina-sde-display.dtsi:21-34) re-pointed by nicole to
+	 * GPIO13, active LOW (nicole.dtsi:295-299, 320-330).
+	 * regulator-boot-on: keep it on, the splash screen is using it.
+	 */
+	panel_avdd: panel-avdd-regulator {
+		compatible = "regulator-fixed";
+		regulator-name = "panel_avdd";
+		regulator-min-microvolt = <5500000>;
+		regulator-max-microvolt = <5500000>;
+		regulator-enable-ramp-delay = <233>;
+		gpio = <&tlmm 13 GPIO_ACTIVE_LOW>;
+		regulator-boot-on;
+
+		pinctrl-0 = <&panel_avdd_en>;
+		pinctrl-names = "default";
+	};
+
+	/*
+	 * PHASE 3: 5 V boost for the detachable controller ("joystick"),
+	 * pm8350_gpios 8, always-on downstream (nicole.dtsi:542-553).
+	 * TODO(cihaz): find out how the controller is wired (USB? usb1 is
+	 * disabled on nicole, nicole.dtsi:577-587).
+	 */
+	joystick_usb_vbus: joystick-usb-vbus-regulator {
+		compatible = "regulator-fixed";
+		regulator-name = "joystick_usb_vbus";
+		regulator-min-microvolt = <5000000>;
+		regulator-max-microvolt = <5000000>;
+		regulator-enable-ramp-delay = <600>;
+		gpio = <&pm8350_gpios 8 GPIO_ACTIVE_HIGH>;
+		enable-active-high;
+
+		pinctrl-0 = <&joystick_vbus_en>;
+		pinctrl-names = "default";
+
+		status = "disabled";
+	};
+
+	/*
+	 * PHASE 3: bit-banged I2C bus for the fan controller.
+	 * nicole.dtsi:512-524: SDA GPIO8, SCL GPIO9, open drain, 5 us delay,
+	 * pins pull-up / 16 mA (nicole.dtsi:449-460).
+	 */
+	i2c-fan {
+		compatible = "i2c-gpio";
+		sda-gpios = <&tlmm 8 (GPIO_ACTIVE_HIGH | GPIO_OPEN_DRAIN)>;
+		scl-gpios = <&tlmm 9 (GPIO_ACTIVE_HIGH | GPIO_OPEN_DRAIN)>;
+		i2c-gpio,delay-us = <5>;
+		#address-cells = <1>;
+		#size-cells = <0>;
+
+		pinctrl-0 = <&fan_i2c_default>;
+		pinctrl-names = "default";
+
+		status = "okay";
+
+		/*
+		 * MAX31760 @0x50 (nicole.dtsi:526-539). Mainline driver
+		 * drivers/hwmon/max31760.c ("adi,max31760") has NO regulator,
+		 * GPIO or cooling-device support and the binding
+		 * (hwmon/adi,max31760.yaml) has additionalProperties: false.
+		 * The supply / GPIO / #cooling-cells properties below are a
+		 * PROPOSED binding extension (driver work needed):
+		 *   vdd  = pm8008j_l7, driver forces 3.3 V (max31760_fan.c:28-29)
+		 *   fan  = pm8008j_l6, 2.8-2.9 V "VDD_FAN" (max31760_fan.c:30-31)
+		 *   vcca = pm8350_s10, 1.8 V (max31760_fan.c:37-38)
+		 *   GPIO78 "usb_charge_contrl", driven 0 at probe (max31760_fan.c:370-383)
+		 *   GPIO93 "dpr_contrl", driven 1 at probe (max31760_fan.c:385-397)
+		 * Fan levels 0..7 -> duty {0x00,0x4e,0x71,0x97,0xb2,0xcc,0xe8,0xff}
+		 * (max31760_fan.c:80). docs/guvenlik-kurallari.md forbids turning the fan off.
+		 */
+		fancontroller: fan-controller@50 {
+			compatible = "adi,max31760";
+			reg = <0x50>;
+			#cooling-cells = <2>;
+
+			vdd-supply = <&pm8008j_l7>;
+			fan-supply = <&pm8008j_l6>;
+			vcca-supply = <&pm8350_s10>;
+			usb-charge-en-gpios = <&tlmm 78 GPIO_ACTIVE_HIGH>;
+			dpr-en-gpios = <&tlmm 93 GPIO_ACTIVE_HIGH>;
+		};
+	};
+
+	/*
+	 * PHASE 3: QCA6490 Wi-Fi/BT power sequencer (WCN6855 family,
+	 * modelled on sm8450-hdk.dts). GPIOs: WLAN_EN 64, BT_EN 65,
+	 * SW_CTRL 153 (lahaina.dtsi:5380-5382, 5646-5648), XO clock GPIO201
+	 * (nicole.dtsi:5-12). Supplies from lahaina.dtsi:5395-5406 and
+	 * 5649-5659: aon S2E, dig S11B, io S10B, rfa1 S1C, rfa2 S12B,
+	 * antenna switch L7E. TODO(cihaz): the exact pmu-input mapping is
+	 * inferred (downstream names differ from the mainline PMU inputs).
+	 */
+	wcn6855-pmu {
+		compatible = "qcom,wcn6855-pmu";
+
+		pinctrl-0 = <&bt_en_state>, <&wlan_en_state>, <&wlan_xo_clk_state>;
+		pinctrl-names = "default";
+
+		wlan-enable-gpios = <&tlmm 64 GPIO_ACTIVE_HIGH>;
+		bt-enable-gpios = <&tlmm 65 GPIO_ACTIVE_HIGH>;
+		swctrl-gpios = <&tlmm 153 GPIO_ACTIVE_HIGH>;
+		xo-clk-gpios = <&tlmm 201 GPIO_ACTIVE_HIGH>;
+
+		vddio-supply = <&pm8350_s10>;
+		vddaon-supply = <&pmr735a_s2>;
+		vddpmu-supply = <&pm8350_s12>;
+		vddpmumx-supply = <&pmr735a_s2>;
+		vddpmucx-supply = <&pm8350_s11>;
+		vddrfa0p95-supply = <&pm8350_s11>;
+		vddrfa1p3-supply = <&pm8350_s12>;
+		vddrfa1p9-supply = <&pm8350c_s1>;
+		vddpcie1p3-supply = <&pm8350_s12>;
+		vddpcie1p9-supply = <&pm8350c_s1>;
+
+
+		regulators {
+			vreg_pmu_rfa_cmn_0p8: ldo0 {
+				regulator-name = "vreg_pmu_rfa_cmn_0p8";
+			};
+
+			vreg_pmu_aon_0p8: ldo1 {
+				regulator-name = "vreg_pmu_aon_0p8";
+			};
+
+			vreg_pmu_wlcx_0p8: ldo2 {
+				regulator-name = "vreg_pmu_wlcx_0p8";
+			};
+
+			vreg_pmu_wlmx_0p8: ldo3 {
+				regulator-name = "vreg_pmu_wlmx_0p8";
+			};
+
+			vreg_pmu_btcmx_0p8: ldo4 {
+				regulator-name = "vreg_pmu_btcmx_0p8";
+			};
+
+			vreg_pmu_pcie_1p8: ldo5 {
+				regulator-name = "vreg_pmu_pcie_1p8";
+			};
+
+			vreg_pmu_pcie_0p9: ldo6 {
+				regulator-name = "vreg_pmu_pcie_0p9";
+			};
+
+			vreg_pmu_rfa_0p8: ldo7 {
+				regulator-name = "vreg_pmu_rfa_0p8";
+			};
+
+			vreg_pmu_rfa_1p2: ldo8 {
+				regulator-name = "vreg_pmu_rfa_1p2";
+			};
+
+			vreg_pmu_rfa_1p7: ldo9 {
+				regulator-name = "vreg_pmu_rfa_1p7";
+			};
+		};
+	};
+};
+
+/*
+ * Remoteprocs. Carveouts identical to mainline (see reserved-memory).
+ * Downstream PAS ids: adsp 1 (lahaina.dtsi:4492), cdsp 18 (:4539),
+ * slpi 12 (:5125) - same as mainline sm8350-adsp/cdsp/slpi-pas.
+ * Firmware comes from the device's modem/NON-HLOS partition as split
+ * .mdt/.bNN files; squash to .mbn (pil-squasher) into
+ * /lib/firmware/qcom/sm8350/razer/nicole/. If the files are absent the
+ * remoteproc simply stays offline.
+ */
+&adsp {
+	firmware-name = "qcom/sm8350/razer/nicole/adsp.mbn";
+	status = "okay";
+};
+
+&cdsp {
+	firmware-name = "qcom/sm8350/razer/nicole/cdsp.mbn";
+	status = "okay";
+};
+
+&slpi {
+	firmware-name = "qcom/sm8350/razer/nicole/slpi.mbn";
+	status = "okay";
+};
+
+/*
+ * Wi-Fi SKU: no modem. The 5G SKU uses an external Quectel module
+ * (nicole.dtsi:494-499, lineage-device init.target.rc Quectel RIL), so
+ * MPSS stays disabled (sm8350.dtsi default) and IPA too (lahainap.dtsi:9-11
+ * disables ipa_hw).
+ */
+&mpss {
+	status = "disabled";
+};
+
+&ipa {
+	status = "disabled";
+};
+
+/*
+ * D4 (31 Ekim 2026): hardware video decode/encode (iris, VPU 2.0). The firmware is the
+ * device's own, signed for this SoC: vendor/firmware/vpu20_4v.mbn (lahaina-vidc.dtsi:37),
+ * put on the phone by scripts/lab/video-firmware.sh, never packaged. linux-firmware has
+ * no sm8350 VPU file (sm8350-hdk's vpu20_p4_sm8350.mbn is not in it). pil_video_mem
+ * (0x85700000+0x500000, sm8350.dtsi) is Razer's carveout too (lahaina.dtsi:339-342).
+ */
+&iris {
+	firmware-name = "qcom/sm8350/razer/nicole/vpu20_4v.mbn";
+
+	status = "okay";
+};
+
+/*
+ * Mainline reserves rmtfs at a fixed 0x9b800000+0x280000; Razer allocates
+ * rmtfs dynamically (qcom,rmtfs_sharedmem reg <0 0x280000>,
+ * lahaina.dtsi:3026-3031), so Android uses that range as normal RAM.
+ * Only the modem needs rmtfs -> drop the carveout.
+ */
+&rmtfs_mem {
+	status = "disabled";
+};
+
+&apps_rsc {
+	/*
+	 * PM8350 (PMIC "b"). Voltages = lahaina-regulators.dtsi ranges
+	 * (never wider). Labels follow the downstream names so that
+	 * S10B == pm8350_s10, L5B == pm8350_l5 etc.
+	 * ARC (level) rails S5/S6/S9/L4/L8 are not listed.
+	 */
+	regulators-0 {
+		compatible = "qcom,pm8350-rpmh-regulators";
+		qcom,pmic-id = "b";
+
+		vdd-s1-supply = <&vph_pwr>;
+		vdd-s2-supply = <&vph_pwr>;
+		vdd-s3-supply = <&vph_pwr>;
+		vdd-s4-supply = <&vph_pwr>;
+		vdd-s5-supply = <&vph_pwr>;
+		vdd-s6-supply = <&vph_pwr>;
+		vdd-s7-supply = <&vph_pwr>;
+		vdd-s8-supply = <&vph_pwr>;
+		vdd-s9-supply = <&vph_pwr>;
+		vdd-s10-supply = <&vph_pwr>;
+		vdd-s11-supply = <&vph_pwr>;
+		vdd-s12-supply = <&vph_pwr>;
+
+		vdd-l1-l4-supply = <&pm8350_s11>;
+		vdd-l2-l7-supply = <&vreg_bob>;
+		vdd-l3-l5-supply = <&vreg_bob>;
+		vdd-l6-l9-l10-supply = <&pm8350_s11>;
+
+		/* regulators:121-126 */
+		pm8350_s10: smps10 {
+			regulator-name = "pm8350_s10";
+			regulator-min-microvolt = <1800000>;
+			regulator-max-microvolt = <1800000>;
+			regulator-initial-mode = <RPMH_REGULATOR_MODE_HPM>;
+		};
+
+		/* regulators:133-138 */
+		pm8350_s11: smps11 {
+			regulator-name = "pm8350_s11";
+			regulator-min-microvolt = <752000>;
+			regulator-max-microvolt = <1012000>;
+			regulator-initial-mode = <RPMH_REGULATOR_MODE_HPM>;
+		};
+
+		/* regulators:150-156 */
+		pm8350_s12: smps12 {
+			regulator-name = "pm8350_s12";
+			regulator-min-microvolt = <1224000>;
+			regulator-max-microvolt = <1360000>;
+			regulator-initial-mode = <RPMH_REGULATOR_MODE_HPM>;
+		};
+
+		/* regulators:168-174, DSI PHY 0.9 V + USB QMP PHY */
+		pm8350_l1: ldo1 {
+			regulator-name = "pm8350_l1";
+			regulator-min-microvolt = <912000>;
+			regulator-max-microvolt = <920000>;
+			regulator-initial-mode = <RPMH_REGULATOR_MODE_HPM>;
+		};
+
+		/* regulators:187-193, USB HS PHY 3.1 V */
+		pm8350_l2: ldo2 {
+			regulator-name = "pm8350_l2";
+			regulator-min-microvolt = <3072000>;
+			regulator-max-microvolt = <3072000>;
+			regulator-initial-mode = <RPMH_REGULATOR_MODE_HPM>;
+		};
+
+		/* regulators:207-213 */
+		pm8350_l3: ldo3 {
+			regulator-name = "pm8350_l3";
+			regulator-min-microvolt = <904000>;
+			regulator-max-microvolt = <904000>;
+			regulator-initial-mode = <RPMH_REGULATOR_MODE_HPM>;
+		};
+
+		/* regulators:242-248, USB HS PHY / UFS PHY / PCIe 0.88 V */
+		pm8350_l5: ldo5 {
+			regulator-name = "pm8350_l5";
+			regulator-min-microvolt = <880000>;
+			regulator-max-microvolt = <888000>;
+			regulator-initial-mode = <RPMH_REGULATOR_MODE_HPM>;
+			/*
+			 * Fixed HPM (no allow-set-load / LPM), a precaution: shared PHY rail
+			 * (USB HS PHY PLL, UFS PHY, DSI PHY) and the USB PHY votes no load,
+			 * so a UFS PHY load drop could otherwise put it in LPM. (The NCM
+			 * link failures of 2026-10-25 that prompted this were the Mac's
+			 * screen lock holding back new USB accessories, not this rail.)
+			 */
+			regulator-allowed-modes = <RPMH_REGULATOR_MODE_HPM>;
+		};
+
+		/* regulators:282-288, DSI 1.2 V / PHY PLLs */
+		pm8350_l6: ldo6 {
+			regulator-name = "pm8350_l6";
+			regulator-min-microvolt = <1200000>;
+			regulator-max-microvolt = <1208000>;
+			regulator-initial-mode = <RPMH_REGULATOR_MODE_HPM>;
+			/*
+			 * Fixed HPM (no allow-set-load / LPM), a precaution: shared PHY rail
+			 * (USB HS PHY PLL, UFS PHY, DSI PHY) and the USB PHY votes no load,
+			 * so a UFS PHY load drop could otherwise put it in LPM. (The NCM
+			 * link failures of 2026-10-25 that prompted this were the Mac's
+			 * screen lock holding back new USB accessories, not this rail.)
+			 */
+			regulator-allowed-modes = <RPMH_REGULATOR_MODE_HPM>;
+		};
+
+		/* regulators:302-308, UFS VCC (UFS disabled in phase 2) */
+		pm8350_l7: ldo7 {
+			regulator-name = "pm8350_l7";
+			regulator-min-microvolt = <2400000>;
+			regulator-max-microvolt = <3008000>;
+			regulator-initial-mode = <RPMH_REGULATOR_MODE_HPM>;
+			regulator-allow-set-load;
+			regulator-allowed-modes = <RPMH_REGULATOR_MODE_LPM
+						   RPMH_REGULATOR_MODE_HPM>;
+		};
+
+		/* regulators:336-342, UFS VCCQ */
+		pm8350_l9: ldo9 {
+			regulator-name = "pm8350_l9";
+			regulator-min-microvolt = <1200000>;
+			regulator-max-microvolt = <1200000>;
+			regulator-initial-mode = <RPMH_REGULATOR_MODE_HPM>;
+			regulator-allow-set-load;
+			regulator-allowed-modes = <RPMH_REGULATOR_MODE_LPM
+						   RPMH_REGULATOR_MODE_HPM>;
+		};
+	};
+
+	/* PM8350C (PMIC "c"). ARC rails S2/S4/S6/S8 not listed. */
+	regulators-1 {
+		compatible = "qcom,pm8350c-rpmh-regulators";
+		qcom,pmic-id = "c";
+
+		vdd-s1-supply = <&vph_pwr>;
+		vdd-s2-supply = <&vph_pwr>;
+		vdd-s3-supply = <&vph_pwr>;
+		vdd-s4-supply = <&vph_pwr>;
+		vdd-s5-supply = <&vph_pwr>;
+		vdd-s6-supply = <&vph_pwr>;
+		vdd-s7-supply = <&vph_pwr>;
+		vdd-s8-supply = <&vph_pwr>;
+		vdd-s9-supply = <&vph_pwr>;
+		vdd-s10-supply = <&vph_pwr>;
+
+		vdd-l1-l12-supply = <&pm8350c_s1>;
+		vdd-l2-l8-supply = <&pm8350c_s1>;
+		vdd-l3-l4-l5-l7-l13-supply = <&vreg_bob>;
+		vdd-l6-l9-l11-supply = <&vreg_bob>;
+		vdd-l10-supply = <&pm8350_s12>;
+
+		vdd-bob-supply = <&vph_pwr>;
+
+		/* regulators:349-354 */
+		pm8350c_s1: smps1 {
+			regulator-name = "pm8350c_s1";
+			regulator-min-microvolt = <1800000>;
+			regulator-max-microvolt = <1952000>;
+			regulator-initial-mode = <RPMH_REGULATOR_MODE_HPM>;
+		};
+
+		/* regulators:377-382 */
