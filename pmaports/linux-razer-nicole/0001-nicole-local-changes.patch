+/*
+ * ===================================================================
+ * PROJECT CONTRACT (docs/guvenlik-kurallari.md, Seviye 4): internal UFS must stay
+ * DISABLED until the Phase 3 approval. Do not enable these two nodes,
+ * do not add supplies, do not "test" them. Razer's UFS config for later:
+ * qrd-common:9-38 (vcc L7B 2.504-2.95 V, vccq L9B, phy L5B/L6B).
+ * ===================================================================
+ */
+/*
+ * UFS stays disabled here. Faz 3 (dar, docs/guvenlik-kurallari.md §8, 25 Ekim 2026) only allows
+ * read-only access to copy the device's own firmware partitions: the extraction
+ * variant flips status with fdtput (scripts/lab/ufs-oku.sh) and runs the mini
+ * initramfs, which sets every sd* read-only before reading. Supplies: Razer
+ * lahaina-qrd-common.dtsi:20-38 (in nicole's include chain), phy as sm8350-hdk.
+ */
+&ufs_mem_hc {
+	reset-gpios = <&tlmm 203 GPIO_ACTIVE_LOW>;
+
+	vcc-supply = <&pm8350_l7>;
+	vcc-max-microamp = <800000>;
+	vccq-supply = <&pm8350_l9>;
+	vccq-max-microamp = <900000>;
+
+	status = "disabled";
+};
+
+&ufs_mem_phy {
+	vdda-phy-supply = <&pm8350_l5>;
+	vdda-pll-supply = <&pm8350_l6>;
+
+	status = "disabled";
+};
+
+/*
+ * USB: only the primary controller (a600000) exists on nicole; usb1/usb_2
+ * is disabled downstream (nicole.dtsi:577-587).
+ * D1 (30 Ekim 2026): dual role, High-Speed only. The role switch is driven
+ * from user space (device-razer-nicole: udev rule + nicole-usb-rol, which
+ * copies UCSI's /sys/class/typec/port0 data_role into usb_role): with
+ * pmic-glink connector@0 enabled and wired to this role switch the link
+ * never came up (stuck in Suspend, the Mac saw nothing; the experiment's
+ * diff is in the author's notes). Default role is
+ * device, so the USB network to the Mac works with no rule at all.
+ * usb_1_qmpphy is on and gives the PIPE clock; maximum-speed stays
+ * high-speed until the Type-C orientation is handled (D2).
+ * Host role: xHCI comes up and VBUS is sourced, but no device connects
+ * yet.
+ */
+&usb_1 {
+	/*
+	 * USB 2.0 only (maximum-speed below), so take the PIPE clock from UTMI:
+	 * with the Type-C graph live the QMP PHY belongs to DisplayPort, and a
+	 * dwc3 fed by its pipe clock lost device mode (D2 deneme C, 31 Ekim).
+	 */
+	qcom,select-utmi-as-pipe-clk;
+
+	status = "okay";
+};
+
+&usb_1_dwc3 {
+	dr_mode = "otg";
+	usb-role-switch;
+	role-switch-default-mode = "peripheral";
+	maximum-speed = "high-speed";
+	phys = <&usb_1_hsphy>;
+	phy-names = "usb2-phy";
+};
+
+/* lahaina-usb.dtsi:118-127: vdd L5B, vdda18 L1C, vdda33 L2B */
+&usb_1_hsphy {
+	vdda-pll-supply = <&pm8350_l5>;
+	vdda18-supply = <&pm8350c_l1>;
+	vdda33-supply = <&pm8350_l2>;
+
+	status = "okay";
+};
+
+/* lahaina-usb.dtsi:142-150: vdd L1B, core L6B */
+&usb_1_qmpphy {
+	vdda-phy-supply = <&pm8350_l1>;
+	vdda-pll-supply = <&pm8350_l6>;
+
+	status = "okay";
+};
+
+&usb_1_qmpphy_out {
+	remote-endpoint = <&pmic_glink_ss_in>;
+};
+
+&mdss_dp {
+	status = "okay";
+};
+
+&mdss_dp_out {
+	data-lanes = <0 1>;
+};
