+/*
+ * Adreno 660. Zap shader carveout pil_gpu_mem is identical. The zap shader
+ * is Razer's (vendor_b /firmware/a660_zap.mdt, squashed; docs/guvenlik-kurallari.md §8, 29 Ekim):
+ * local only, never packaged. SQE/GMU firmware: firmware-qcom-adreno-a660.
+ */
+&gpu {
+	status = "okay";
+};
+
+/*
+ * No QCE driver in the kernel config: an unbound crypto node holds both
+ * interconnect providers' sync_state(), so the boot-time maximum bandwidth
+ * (DDR/NoC clocks) is never dropped. Safe to release only because the
+ * framebuffer node votes for the MDP scanout paths (see framebuffer0).
+ */
+&crypto {
+	status = "disabled";
+};
+
+/*
+ * On together with the GPU: an enabled GMU without a bound driver would hold
+ * gcc and gpucc sync_state(), so unused GDSCs (UFS, video, SF TBUs) stay on.
+ */
+&gmu {
+	status = "okay";
+};
+
+&gpu_zap_shader {
+	firmware-name = "qcom/sm8350/razer/nicole/a660_zap.mbn";
+};
+
+/*
+ * PHASE 3: QUP SE13 I2C (lahaina-qupv3.dtsi:737-756, pins GPIO0/1
+ * pinctrl:1440-1450). NOTE: downstream marks this SE "qcom,shared"
+ * (lahaina-qupv3.dtsi:754, shared with another execution environment);
+ * mainline i2c-qcom-geni has no equivalent. Clock not specified
+ * downstream -> 100 kHz like sagami.
+ * Expected devices (TODO(cihaz): confirm with i2cdetect on bus 13):
+ *   0x0c/0x0d PM8008 "j"  (pmic-overlay:168-273; "i" @0x08/0x09 is
+ *                          disabled by nicole.dtsi:166-170, and its reset
+ *                          GPIO33 is listed as NC in nicole.dtsi:333-345)
+ *   0x42      FSA4480     (lahaina-audio.dtsi:204-209)
+ *   0x1c      NB7VPQ904M  (ONLY in lahaina-qrd.dtsi:31-65, which nicole
+ *                          does NOT include -> presence unverified)
+ */
+&i2c13 {
+	clock-frequency = <100000>;
+	/* M2: on for PM8008 "j" (fan supplies); the USB-C chips below stay
+	 * off until the Type-C graph is verified */
+	status = "okay";
+
+	/*
+	 * PM8008 "j": mainline "qcom,pm8008" uses reg = first address and
+	 * reaches the regulator block at reg+1 (0x0d) itself.
+	 * Supplies: pmic-overlay:203-208 (l1/l2 S12B, l3/l4 S1C, l5-l7 BOB).
+	 * Reset: GPIO35, driven high when active (pinctrl:2880-2892).
+	 * TODO(cihaz): interrupt is not described downstream. On the HDK the
+	 * pin pairs are 32/33 (PM8008_1 IRQ/RESET) and 34/35 (PM8008_2
+	 * IRQ/RESET) (sm8350-hdk.dts gpio-line-names) -> GPIO34 assumed.
+	 * Consumers: fan (vdd l7, fan l6), front camera (l1/l3/l5,
+	 * camera/lahaina-camera-sensor-nicole.dtsi:14-16).
+	 */
+	pm8008j: pmic@c {
+		compatible = "qcom,pm8008";
+		reg = <0xc>;
+
+		interrupts-extended = <&tlmm 34 IRQ_TYPE_EDGE_RISING>;
+		reset-gpios = <&tlmm 35 GPIO_ACTIVE_LOW>;
+
+		vdd-l1-l2-supply = <&pm8350_s12>;
+		vdd-l3-l4-supply = <&pm8350c_s1>;
+		vdd-l5-supply = <&vreg_bob>;
+		vdd-l6-supply = <&vreg_bob>;
+		vdd-l7-supply = <&vreg_bob>;
+
+		pinctrl-0 = <&pm8008j_default>;
+		pinctrl-names = "default";
+
+		gpio-controller;
+		#gpio-cells = <2>;
+		gpio-ranges = <&pm8008j 0 0 2>;
+
+		interrupt-controller;
+		#interrupt-cells = <2>;
+
+		#thermal-sensor-cells = <0>;
+
+		regulators {
+			/* pmic-overlay:210-217, nicole.dtsi:179-182 forces 1.2 V */
+			pm8008j_l1: ldo1 {
+				regulator-name = "pm8008j_l1";
+				regulator-min-microvolt = <1200000>;
+				regulator-max-microvolt = <1200000>;
+			};
+
+			/* pmic-overlay:219-226 */
+			pm8008j_l2: ldo2 {
+				regulator-name = "pm8008j_l2";
+				regulator-min-microvolt = <944000>;
+				regulator-max-microvolt = <1056000>;
+			};
+
+			/* pmic-overlay:228-235 */
+			/* front camera vio: 1.8 V fixed, as the downstream sensor
+			 * node asks (camera/lahaina-camera-sensor-nicole.dtsi:61) */
+			pm8008j_l3: ldo3 {
+				regulator-name = "pm8008j_l3";
+				regulator-min-microvolt = <1800000>;
+				regulator-max-microvolt = <1800000>;
+			};
+
+			/* pmic-overlay:237-244 */
+			pm8008j_l4: ldo4 {
+				regulator-name = "pm8008j_l4";
+				regulator-min-microvolt = <1728000>;
+				regulator-max-microvolt = <1800000>;
+			};
+
+			/* pmic-overlay:246-253 */
+			/* front camera vana: 2.8 V fixed (same downstream line) */
+			pm8008j_l5: ldo5 {
+				regulator-name = "pm8008j_l5";
+				regulator-min-microvolt = <2800000>;
+				regulator-max-microvolt = <2800000>;
+			};
+
+			/* pmic-overlay:255-262 + nicole.dtsi:184-186 (max 2.9 V):
+			 * fan motor supply */
+			pm8008j_l6: ldo6 {
+				regulator-name = "pm8008j_l6";
+				regulator-min-microvolt = <2800000>;
+				regulator-max-microvolt = <2900000>;
+				/* mainline max31760 takes no supplies; the fan
+				 * must never be unpowered (docs/guvenlik-kurallari.md) */
+				regulator-always-on;
+			};
+
+			/* nicole.dtsi:188-191 (3.2-3.3 V; overrides 2.808-3.6 V
+			 * of pmic-overlay:264-271): fan controller VDD */
+			pm8008j_l7: ldo7 {
+				regulator-name = "pm8008j_l7";
+				regulator-min-microvolt = <3200000>;
+				regulator-max-microvolt = <3300000>;
+				regulator-always-on;
+			};
+		};
+	};
+
+	/*
+	 * FSA4480 USB-C SBU/analog-audio switch (lahaina-audio.dtsi:204-209).
+	 * Downstream gives no IRQ and no supply. TODO(cihaz): IRQ GPIO;
+	 * vcc assumed BOB like sm8350-hdk.dts:417-432.
+	 */
+	typec-mux@42 {
+		compatible = "fcs,fsa4480";
+		reg = <0x42>;
+
+		vcc-supply = <&vreg_bob>;
+
+		mode-switch;
+		orientation-switch;
+
+		status = "okay";
+
+		port {
+			fsa4480_sbu_mux: endpoint {
+				remote-endpoint = <&pmic_glink_sbu>;
+			};
+		};
+	};
+
+};
+
+/*
+ * Speakers: two Awinic AW88261 smart amps on QUP SE17 I2C (GPIO72/73,
+ * pinctrl:1552-1564), chip ID 0x2113 read on the device (28 Oct 2026).
+ * nicole.dtsi:193-223: @0x34 = channel 0 (left, IRQ GPIO90), @0x35 =
+ * channel 1 (right, IRQ GPIO119); no reset line. Fed over PRI MI2S RX on
+ * SD0 (nicole.dtsi:59-65: qcom,msm-mi2s-lines = <1>); SD1 carries the amps'
+ * I/V feedback (TX) for Razer's ADSP speaker protection, not used here.
+ * Firmware: Razer's vendor/firmware/aw882xx_acf.bin (an AW88261 ACF with
+ * profiles for both channels), installed under the name below.
+ * dvdd: no supply in the downstream DT; the amps answer on I2C from boot,
+ * so it is an always-on 1.8 V rail. S10B is the board's 1.8 V I/O rail
+ * (WCD938x, fan, WLAN I/O) -- assumption, TODO: confirm from schematics.
+ */
+&i2c17 {
+	clock-frequency = <400000>;
+	status = "okay";
+
+	speaker_left: audio-codec@34 {
+		compatible = "awinic,aw88261";
+		reg = <0x34>;
+		#sound-dai-cells = <0>;
+		dvdd-supply = <&pm8350_s10>;
+		awinic,audio-channel = <0>;
+		firmware-name = "qcom/sm8350/razer/nicole/aw88261_acf.bin";
+		sound-name-prefix = "Left";
+	};
+
+	speaker_right: audio-codec@35 {
+		compatible = "awinic,aw88261";
+		reg = <0x35>;
+		#sound-dai-cells = <0>;
+		dvdd-supply = <&pm8350_s10>;
+		awinic,audio-channel = <1>;
+		firmware-name = "qcom/sm8350/razer/nicole/aw88261_acf.bin";
+		sound-name-prefix = "Right";
+	};
+};
+
+&q6afedai {
+	dai@16 {
+		reg = <PRIMARY_MI2S_RX>;
+		qcom,sd-lines = <0>;
+	};
+};
