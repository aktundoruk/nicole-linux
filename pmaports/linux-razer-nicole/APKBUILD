05e85eb476595f089ecb3e05910347b553d619f13a2ddb138bcd5b4b5a7d3d967330c49d29b47e1b56e6ec825b0c42d00fa2e39573936bc1660a35a0bb5516d9  config-razer-nicole.aarch64
